---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Will Meet Soon | A Comfort Corner for Long-Distance Love",
	description = "A warm, comforting haven for long-distance couples. Plan border-free gifts, find your golden hour connection times, and countdown to airport hugs."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Favicons -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		
		<!-- Fonts: Google Fonts Fraunces (warm soft serif) & Plus Jakarta Sans (friendly rounded sans) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..600&family=Plus+Jakarta+Sans:ital,wght@0,300..700;1,300..600&display=swap" rel="stylesheet" />
		
		<!-- Early Theme Script to prevent flash -->
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'light'; // Default: warm daylight haven
			})();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://willmeetsoon.com/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://willmeetsoon.com/" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
	</head>
	<body class="bg-[#FFFDF9] text-[#2D2226] dark:bg-[#16131A] dark:text-[#FDFBF7] selection:bg-[#FDE8EF] selection:text-[#E15B7B] dark:selection:bg-[#FBBF24]/20 dark:selection:text-[#FBBF24] min-h-screen flex flex-col justify-between relative overflow-x-hidden transition-colors duration-400">
		
		<!-- Ambient Atmosphere: Warm Sunlight Blooms & Candlelight Starry Sky -->
		<div class="sunlight-blooms"></div>
		<div class="starry-sky-overlay"></div>

		<!-- Playful Floating Ambient Accents -->
		<div class="fixed top-28 right-8 pointer-events-none opacity-40 dark:opacity-25 animate-float text-xl select-none z-0 hidden sm:block" aria-hidden="true">
			✨
		</div>
		<div class="fixed bottom-24 left-8 pointer-events-none opacity-30 dark:opacity-20 animate-float-reverse text-lg select-none z-0 hidden sm:block" aria-hidden="true">
			💌
		</div>
		<div class="fixed top-1/2 left-6 pointer-events-none opacity-25 dark:opacity-15 animate-twinkle text-base select-none z-0 hidden lg:block" aria-hidden="true">
			🌸
		</div>
		<div class="fixed top-2/3 right-10 pointer-events-none opacity-30 dark:opacity-20 animate-float text-sm select-none z-0 hidden lg:block" aria-hidden="true">
			🕊️
		</div>

		<!-- Friendly Global Navbar -->
		<Navbar />

		<!-- Main Content Slot with open breathing space -->
		<main class="flex-grow w-full relative z-10 flex flex-col">
			<slot />
		</main>

		<!-- Heartfelt Global Footer -->
		<Footer />
	</body>
</html>
