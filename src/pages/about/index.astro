---
// src/pages/about/index.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout title="About Us | Will Meet Soon" description="Learn about the mission, features, and core beliefs behind Will Meet Soon, the premium toolkit for long-distance relationships.">
  <div class="py-12">
    <!-- Header Hero -->
    <div class="w-full max-w-4xl mx-auto px-6 text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/5 rounded-full border border-white/10 mb-6">
        <span class="text-[10px] md:text-xs font-medium text-neutral-300 tracking-wider uppercase">
          Our Mission
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-light text-white tracking-[-1.8px] leading-[1.05] mb-6 max-w-3xl mx-auto text-balance">
        Banish the distance <span class="bg-gradient-to-r from-[#533afd] via-[#f96bee] to-[#ea2261] bg-clip-text text-transparent font-medium">between hearts</span>
      </h1>
      <p class="text-base md:text-lg font-light text-[#64748d] max-w-xl mx-auto leading-relaxed text-pretty">
        Will Meet Soon is built on a single, simple premise: love should not be limited by logistics. We build tools that make long-distance relationships thrive.
      </p>
    </div>

    <!-- Main Content Section -->
    <div class="w-full max-w-3xl mx-auto px-6 mb-16 space-y-12">
      <!-- Section 1 -->
      <div class="glow-border rounded-xl p-8 relative overflow-hidden">
        <h3 class="text-xl font-medium text-white mb-4">The Challenge of Distance</h3>
        <p class="text-sm text-[#64748d] font-light leading-relaxed mb-4">
          Over 14 million couples in the US alone identify as being in a long-distance relationship. While digital video calls and instant messaging keep us connected, they do not resolve the structural challenges of physical separation.
        </p>
        <p class="text-sm text-[#64748d] font-light leading-relaxed">
          Unexpected 40% customs duty rates on overseas gifts, complex time differences that turn coordinate attempts into mathematical calculations, and repetitive "FaceTime calls" that lack active participation can strain even the strongest connections.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="glow-border rounded-xl p-8 relative overflow-hidden">
        <h3 class="text-xl font-medium text-white mb-4">Our Core Philosophy</h3>
        <p class="text-sm text-[#64748d] font-light leading-relaxed mb-4 font-sans">
          We believe that software should remove administrative friction from human relationships. Our suite of tools is designed to address the key friction points of LDRs:
        </p>
        <ul class="space-y-3 text-xs text-[#61718a] font-light mt-4">
          <li class="flex items-start gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span><strong>Zero-Customs Sourcing</strong>: Finding local stores inside your partner's country to bypass international courier customs.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#533afd] font-bold">✓</span>
            <span><strong>Timezone Synchronization</strong>: Finding visual overlaps where couples are naturally awake and free to talk.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[#ea2261] font-bold">✓</span>
            <span><strong>Shared Virtual Rituals</strong>: Providing active date ideas like synced streaming media and cooking battles.</span>
          </li>
        </ul>
      </div>

      <!-- Section 3 -->
      <div class="text-center pt-6">
        <h4 class="text-sm font-semibold tracking-widest text-[#61718a] uppercase mb-4">Join Will Meet Soon</h4>
        <p class="text-xs text-[#64748d] max-w-md mx-auto font-light leading-relaxed mb-8">
          Whether you are separated by state borders or oceans, we want to help you close the distance. Our platform is and will remain free for all couples.
        </p>
        <a href="/" class="bg-[#533afd] text-white hover:bg-[#665efd] text-xs font-semibold px-6 py-2.5 rounded-lg transition-colors focus-ring">
          Explore Our Tools
        </a>
      </div>
    </div>
  </div>
</Layout>
