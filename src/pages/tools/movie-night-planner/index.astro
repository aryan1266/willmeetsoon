---
// src/pages/tools/movie-night-planner/index.astro
import ToolLayout from "../../../layouts/ToolLayout.astro";
---

<ToolLayout
  title="Movie Night Planner | Will Meet Soon"
  description="Synchronize streaming queues and video chats for cozy couch cuddles across the distance."
  toolName="Movie Night Planner"
  toolDescription="Couch cuddles from across the world. Synchronize your streaming queues, share real-time reactions, and never count down '3, 2, 1, hit play' again."
>
  <span slot="hero-title">
    Synchronized streams for <span class="bg-gradient-to-r from-[#E15B7B] via-[#FB923C] to-[#F59E0B] bg-clip-text text-transparent italic font-normal">cozy movie nights</span>
  </span>

  <div class="max-w-3xl mx-auto">
    <div class="card-cozy p-8 sm:p-12 mb-10 text-center relative overflow-hidden">
      <!-- Ambient Berry Glow -->
      <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full bg-gradient-to-br from-[#FDE8EF]/50 to-[#FFF1E6]/40 dark:from-[#E15B7B]/10 dark:to-[#FBBF24]/5 blur-3xl pointer-events-none"></div>

      <div class="relative z-10">
        <!-- Friendly In-Development Banner -->
        <div class="mb-6 p-4 rounded-2xl bg-[#F3E8FF]/80 dark:bg-[#A855F7]/10 border border-[#E9D5FF] dark:border-[#A855F7]/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2.5 text-[#7E22CE] dark:text-[#C084FC]">
            <span class="text-base">🎬</span>
            <span>We're currently crafting this tool with extra care. In the meantime, our <strong>Gift & Date Planner</strong> is live!</span>
          </div>
          <a href="/tools/gift-date-planner" class="px-4 py-1.5 rounded-full bg-[#E15B7B] text-white font-semibold hover:bg-[#CC4B6B] transition-all shrink-0">
            Open Gift Planner 🎁
          </a>
        </div>

        <span class="stamp-badge text-xs text-[#E15B7B] dark:text-[#FBBF24] mb-6 inline-block">
          🍿 Couch Cuddles · Preview
        </span>
        
        <!-- Mock Streaming Screen with Cozy Warm Theater Frame -->
        <div class="bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] rounded-3xl overflow-hidden mb-8 shadow-sm aspect-video max-w-xl mx-auto flex flex-col justify-between p-5 relative">
          <!-- Ambient cinema glow -->
          <div class="absolute inset-0 bg-gradient-to-tr from-[#FDE8EF]/20 via-transparent to-[#FEF9C3]/20 dark:from-[#E15B7B]/10 dark:to-transparent pointer-events-none"></div>

          <!-- Top Overlay: Live Status & Video Bubbles -->
          <div class="flex items-start justify-between w-full relative z-10">
            <span class="text-[10px] bg-[#E8F7F0] dark:bg-[#10B981]/20 text-[#10B981] font-semibold px-3 py-1 border border-[#10B981]/20 rounded-full flex items-center gap-1.5 shadow-sm">
              <span class="w-1.5 h-1.5 bg-[#10B981] rounded-full animate-ping"></span> Perfectly In-Sync
            </span>
            <!-- Friendly Video Avatars -->
            <div class="flex gap-2">
              <div class="w-14 h-12 rounded-xl bg-white dark:bg-[#261E2C] border border-[#F0E5DC] dark:border-[#3D3145] flex flex-col items-center justify-center text-[10px] shadow-sm">
                <span>😊</span>
                <span class="text-[8px] text-[#78666C] dark:text-[#C4B6BE]">You</span>
              </div>
              <div class="w-14 h-12 rounded-xl bg-white dark:bg-[#261E2C] border border-[#F0E5DC] dark:border-[#3D3145] flex flex-col items-center justify-center text-[10px] shadow-sm">
                <span>🥰</span>
                <span class="text-[8px] text-[#78666C] dark:text-[#C4B6BE]">Partner</span>
              </div>
            </div>
          </div>

          <!-- Middle Cozy Play Prompt -->
          <div class="self-center relative z-10 my-auto text-center">
            <div class="w-14 h-14 rounded-full bg-[#E15B7B] text-white flex items-center justify-center shadow-md mx-auto mb-2 cursor-not-allowed">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-6 h-6 ml-0.5">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
            <span class="text-xs font-serif text-[#2D2226] dark:text-[#FDFBF7]">"About Time" · Ready to play together</span>
          </div>

          <!-- Bottom Control Bar -->
          <div class="w-full relative z-10 bg-white/90 dark:bg-[#261E2C]/90 backdrop-blur-sm rounded-xl p-2.5 flex items-center justify-between text-[11px] text-[#78666C] dark:text-[#C4B6BE] border border-[#F0E5DC] dark:border-[#3D3145]">
            <span class="tabular-nums">00:00 / 02:03:00</span>
            <div class="w-1/2 h-1.5 bg-[#FAF5EE] dark:bg-[#1A141F] rounded-full relative overflow-hidden">
              <div class="absolute left-0 top-0 bottom-0 w-1/3 bg-[#E15B7B] rounded-full"></div>
            </div>
            <span class="text-[10px] font-semibold text-[#E15B7B] dark:text-[#FBBF24]">Synced 🍿</span>
          </div>
        </div>

        <p class="text-sm text-[#78666C] dark:text-[#C4B6BE] font-light max-w-lg mx-auto leading-relaxed mb-8">
          Watch together, laugh together, and reach for the tissues at the exact same scene. Our planner pairs synchronized streaming with crisp floating reactions.
        </p>

        <!-- Search input preview -->
        <div class="card-cozy p-6 max-w-md mx-auto text-left shadow-sm bg-white dark:bg-[#1F1924] mb-8">
          <label class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-2">Movie or Watch-Party URL</label>
          <div class="flex gap-2">
            <input type="text" value="https://www.netflix.com/title/80018499" class="flex-grow bg-[#FAF5EE] dark:bg-[#16131A] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl px-3.5 py-2 text-xs text-[#2D2226] dark:text-[#FDFBF7]" disabled />
            <button class="btn-lovable bg-[#E15B7B] text-white text-xs px-4 py-2 cursor-not-allowed" disabled>Sync ✨</button>
          </div>
        </div>

        <div class="flex justify-center">
          <a href="/" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#FAF5EE] dark:bg-[#1F1924] border border-[#F0E5DC] dark:border-[#3D3145] hover:border-[#E15B7B]/40 text-xs font-medium text-[#2D2226] dark:text-[#FDFBF7] transition-all">
            <span>← Back to Haven</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>
