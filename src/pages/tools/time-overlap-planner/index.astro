---
// src/pages/tools/time-overlap-planner/index.astro
import ToolLayout from "../../../layouts/ToolLayout.astro";
---

<ToolLayout
  title="Time Overlap Planner | Will Meet Soon"
  description="Visualize your daily rhythms side-by-side to discover the sweet windows where both of you are awake, relaxed, and free to talk."
  toolName="Time Overlap Planner"
  toolDescription="See both of your daily rhythms side-by-side to find that magical golden hour where one is waking with morning coffee and the other is unwinding."
>
  <span slot="hero-title">
    Find your daily <span class="bg-gradient-to-r from-[#FB923C] via-[#F59E0B] to-[#E15B7B] bg-clip-text text-transparent italic font-normal">golden chat hours</span>
  </span>

  <div class="max-w-3xl mx-auto">
    <div class="card-cozy p-8 sm:p-12 mb-10 text-center relative overflow-hidden">
      <!-- Ambient Sunlit Glow -->
      <div class="absolute -left-12 -top-12 w-64 h-64 rounded-full bg-gradient-to-br from-[#FEF9C3]/50 to-[#FFF1E6]/40 dark:from-[#FBBF24]/10 dark:to-[#FB923C]/5 blur-3xl pointer-events-none"></div>

      <div class="relative z-10">
        <!-- Friendly In-Development Banner -->
        <div class="mb-6 p-4 rounded-2xl bg-[#FFF1E6]/80 dark:bg-[#FB923C]/10 border border-[#FED7AA] dark:border-[#FB923C]/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2.5 text-[#C2410C] dark:text-[#FB923C]">
            <span class="text-base">☕</span>
            <span>We're currently crafting this tool with extra care. In the meantime, our <strong>Gift & Date Planner</strong> is live!</span>
          </div>
          <a href="/tools/gift-date-planner" class="px-4 py-1.5 rounded-full bg-[#E15B7B] text-white font-semibold hover:bg-[#CC4B6B] transition-all shrink-0">
            Open Gift Planner 🎁
          </a>
        </div>

        <span class="stamp-badge text-xs text-[#FB923C] dark:text-[#FBBF24] mb-6 inline-block">
          ☀️ Sunlight & Moonlight Ribbon · Preview
        </span>
        
        <!-- Schedule Visualizer -->
        <div class="space-y-5 mb-8 max-w-xl mx-auto text-left">
          <!-- Timezone A (PST) -->
          <div class="bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="text-base">☕</span>
                <span class="text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7]">San Francisco (PST · UTC-8)</span>
              </div>
              <span class="text-xs text-[#E15B7B] dark:text-[#FBBF24] font-semibold tabular-nums">10:00 AM</span>
            </div>
            <!-- Horizontal visual track -->
            <div class="h-8 bg-white dark:bg-[#261E2C] rounded-xl relative flex overflow-hidden border border-[#F0E5DC] dark:border-[#3D3145]">
              <div class="w-1/3 bg-[#FAF5EE] dark:bg-[#1A141F] flex items-center justify-center border-r border-[#F0E5DC] dark:border-[#3D3145]">
                <span class="text-[9px] text-[#78666C] dark:text-[#C4B6BE]">🌙 Deep Sleep</span>
              </div>
              <div class="w-1/3 bg-[#E8F7F0] dark:bg-[#10B981]/15 border-r border-[#F0E5DC] dark:border-[#3D3145] flex items-center justify-center">
                <span class="text-[9px] text-[#10B981] font-semibold">☕ Awake & Coffee</span>
              </div>
              <div class="w-1/3 bg-[#FDE8EF] dark:bg-[#E15B7B]/20 flex items-center justify-center">
                <span class="text-[9px] text-[#E15B7B] dark:text-[#F472B6] font-bold">✨ Sweet Call Hour</span>
              </div>
            </div>
          </div>

          <!-- Timezone B (IST) -->
          <div class="bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="text-base">🌙</span>
                <span class="text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7]">New Delhi (IST · UTC+5.5)</span>
              </div>
              <span class="text-xs text-[#E15B7B] dark:text-[#FBBF24] font-semibold tabular-nums">11:30 PM</span>
            </div>
            <!-- Horizontal visual track -->
            <div class="h-8 bg-white dark:bg-[#261E2C] rounded-xl relative flex overflow-hidden border border-[#F0E5DC] dark:border-[#3D3145]">
              <div class="w-1/3 bg-[#FDE8EF] dark:bg-[#E15B7B]/20 border-r border-[#F0E5DC] dark:border-[#3D3145] flex items-center justify-center">
                <span class="text-[9px] text-[#E15B7B] dark:text-[#F472B6] font-bold">✨ Sweet Call Hour</span>
              </div>
              <div class="w-1/3 bg-[#FAF5EE] dark:bg-[#1A141F] border-r border-[#F0E5DC] dark:border-[#3D3145] flex items-center justify-center">
                <span class="text-[9px] text-[#78666C] dark:text-[#C4B6BE]">🌙 Deep Sleep</span>
              </div>
              <div class="w-1/3 bg-[#E8F7F0] dark:bg-[#10B981]/15 flex items-center justify-center">
                <span class="text-[9px] text-[#10B981] font-semibold">☕ Awake & Coffee</span>
              </div>
            </div>
          </div>
        </div>

        <p class="text-sm text-[#78666C] dark:text-[#C4B6BE] font-light max-w-lg mx-auto leading-relaxed mb-8">
          No more guessing or waking your partner up by mistake. This tool matches your daily rhythms automatically so neither person has to sacrifice their rest to connect.
        </p>

        <!-- Form Preview -->
        <div class="card-cozy p-6 max-w-md mx-auto text-left shadow-sm bg-white dark:bg-[#1F1924] mb-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-1.5">Your Active Hours</label>
              <input type="text" value="9:00 AM - 5:00 PM" class="w-full bg-[#FAF5EE] dark:bg-[#16131A] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl px-3.5 py-2.5 text-xs text-[#2D2226] dark:text-[#FDFBF7]" disabled />
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-1.5">Partner's Sleep Window</label>
              <input type="text" value="11:00 PM - 7:00 AM" class="w-full bg-[#FAF5EE] dark:bg-[#16131A] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl px-3.5 py-2.5 text-xs text-[#2D2226] dark:text-[#FDFBF7]" disabled />
            </div>
          </div>
        </div>

        <div class="flex justify-center">
          <a href="/" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#FAF5EE] dark:bg-[#1F1924] border border-[#F0E5DC] dark:border-[#3D3145] hover:border-[#E15B7B]/40 text-xs font-medium text-[#2D2226] dark:text-[#FDFBF7] transition-all">
            <span>← Back to Haven</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>
