---
// src/pages/tools/time-overlap-planner/index.astro
import ToolLayout from "../../../layouts/ToolLayout.astro";
---

<ToolLayout
  title="Time Overlap Planner | Will Meet Soon"
  description="Visualize your schedules side-by-side to find the perfect daily windows where both of you are awake and free."
  toolName="Time Overlap Planner"
  toolDescription="Visualize your schedules side-by-side to find the perfect daily windows where both of you are awake and free."
>
  <span slot="hero-title">
    Find your daily <span class="bg-gradient-to-r from-[#533afd] to-[#ea2261] bg-clip-text text-transparent font-medium">communication windows</span>
  </span>

  <div class="max-w-3xl mx-auto">
    <!-- Premium Preview Warning -->
    <div class="glow-border rounded-xl p-8 mb-8 text-center relative overflow-hidden">
      <!-- Ambient Gradient Indicator -->
      <div class="absolute inset-0 bg-[#533afd]/5 z-0 pointer-events-none"></div>
      
      <div class="relative z-10">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-semibold bg-white/5 border border-white/10 text-neutral-300 uppercase tracking-widest mb-6">
          Prototype Preview
        </span>
        
        <!-- Mock Schedule Visualizer -->
        <div class="space-y-4 mb-8 max-w-xl mx-auto text-left">
          <!-- Timezone A (PST) -->
          <div class="bg-[#090a12]/80 border border-white/5 rounded-lg p-4 shadow-xl">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-semibold text-white">Los Angeles (PST / UTC-8)</span>
              <span class="text-[10px] text-[#61718a] tabular-nums font-mono">10:00 AM</span>
            </div>
            <!-- Horizontal visual track -->
            <div class="h-6 bg-white/5 rounded relative flex overflow-hidden">
              <div class="w-1/3 bg-black/40 flex items-center justify-center"><span class="text-[8px] text-[#61718a] uppercase">Sleeping</span></div>
              <div class="w-1/3 bg-emerald-500/20 border-x border-emerald-500/20 flex items-center justify-center"><span class="text-[8px] text-emerald-400 uppercase font-semibold">Awake & Active</span></div>
              <div class="w-1/3 bg-[#533afd]/20 flex items-center justify-center"><span class="text-[8px] text-[#533afd] uppercase font-semibold">Target Call Hour</span></div>
            </div>
          </div>

          <!-- Timezone B (IST) -->
          <div class="bg-[#090a12]/80 border border-white/5 rounded-lg p-4 shadow-xl">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-semibold text-white">New Delhi (IST / UTC+5.5)</span>
              <span class="text-[10px] text-[#61718a] tabular-nums font-mono">11:30 PM</span>
            </div>
            <!-- Horizontal visual track -->
            <div class="h-6 bg-white/5 rounded relative flex overflow-hidden">
              <div class="w-1/3 bg-[#533afd]/20 border-r border-[#533afd]/20 flex items-center justify-center"><span class="text-[8px] text-[#533afd] uppercase font-semibold">Target Call Hour</span></div>
              <div class="w-1/3 bg-black/40 flex items-center justify-center"><span class="text-[8px] text-[#61718a] uppercase">Sleeping</span></div>
              <div class="w-1/3 bg-emerald-500/20 flex items-center justify-center"><span class="text-[8px] text-emerald-400 uppercase font-semibold">Awake & Active</span></div>
            </div>
          </div>
        </div>

        <p class="text-sm text-neutral-300 font-light max-w-lg mx-auto leading-relaxed mb-8">
          Coordinate calls easily. This tool overlays sleep schedules, work hours, and time differences to flag the best windows for text and voice chats automatically.
        </p>

        <!-- Form Fields Mock -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-md mx-auto text-left mb-8">
          <div>
            <label class="block text-[10px] text-[#61718a] uppercase tracking-wider mb-1 font-medium">Your Work Hours</label>
            <input type="text" value="9:00 AM - 5:00 PM" class="w-full bg-[#0b0c16] border border-white/10 rounded px-3 py-2 text-xs font-light text-white cursor-not-allowed" disabled />
          </div>
          <div>
            <label class="block text-[10px] text-[#61718a] uppercase tracking-wider mb-1 font-medium">Partner's Sleep Window</label>
            <input type="text" value="11:00 PM - 7:00 AM" class="w-full bg-[#0b0c16] border border-white/10 rounded px-3 py-2 text-xs font-light text-white cursor-not-allowed" disabled />
          </div>
        </div>

        <div class="flex justify-center">
          <a href="/" class="bg-white/5 border border-white/10 hover:bg-white/10 text-xs text-white font-medium px-6 py-2.5 rounded-lg transition-colors focus-ring">
            ← Back to Tools Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>
