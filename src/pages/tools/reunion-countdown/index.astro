---
// src/pages/tools/reunion-countdown/index.astro
import ToolLayout from "../../../layouts/ToolLayout.astro";
---

<ToolLayout
  title="Reunion Countdown | Will Meet Soon"
  description="Keep the flame glowing bright. Track the exact days, hours, and minutes until you're back in each other's warm embrace."
  toolName="Reunion Countdown"
  toolDescription="Track every heartbeat until your next airport embrace, flight departure, and shared morning coffee."
>
  <span slot="hero-title">
    Counting down to our next <span class="bg-gradient-to-r from-[#E15B7B] via-[#FB923C] to-[#F59E0B] bg-clip-text text-transparent italic font-normal">reunion embrace</span>
  </span>

  <div class="max-w-3xl mx-auto">
    <div class="card-cozy p-8 sm:p-12 mb-10 text-center relative overflow-hidden">
      <!-- Decorative background accent -->
      <div class="absolute -right-12 -bottom-12 w-64 h-64 rounded-full bg-gradient-to-tr from-[#FDE8EF]/50 to-[#FEF9C3]/40 dark:from-[#E15B7B]/10 dark:to-[#FBBF24]/5 blur-3xl pointer-events-none"></div>

      <div class="relative z-10">
        <!-- Friendly In-Development Banner -->
        <div class="mb-6 p-4 rounded-2xl bg-[#FEF9C3]/70 dark:bg-[#FBBF24]/10 border border-[#FDE047] dark:border-[#FBBF24]/30 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2.5 text-[#B45309] dark:text-[#FBBF24]">
            <span class="text-base">🌸</span>
            <span>We're currently crafting this tool with extra care. In the meantime, our <strong>Gift & Date Planner</strong> is live!</span>
          </div>
          <a href="/tools/gift-date-planner" class="px-4 py-1.5 rounded-full bg-[#E15B7B] text-white font-semibold hover:bg-[#CC4B6B] transition-all shrink-0">
            Open Gift Planner 🎁
          </a>
        </div>

        <span class="stamp-badge text-xs text-[#E15B7B] dark:text-[#FBBF24] mb-6 inline-block">
          ✨ Airport Hug Tracker · Preview
        </span>
        
        <!-- Lovable Countdown Display -->
        <div class="flex justify-center gap-3 sm:gap-6 mb-8 text-center">
          <div class="flex flex-col bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] w-20 h-24 sm:w-28 sm:h-28 rounded-2xl items-center justify-center shadow-sm">
            <span class="text-3xl sm:text-4xl font-serif text-[#2D2226] dark:text-[#FDFBF7] tabular-nums leading-none mb-1.5">28</span>
            <span class="text-[10px] text-[#78666C] dark:text-[#C4B6BE] uppercase tracking-wider font-medium">Days</span>
          </div>
          <div class="flex flex-col bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] w-20 h-24 sm:w-28 sm:h-28 rounded-2xl items-center justify-center shadow-sm">
            <span class="text-3xl sm:text-4xl font-serif text-[#2D2226] dark:text-[#FDFBF7] tabular-nums leading-none mb-1.5">14</span>
            <span class="text-[10px] text-[#78666C] dark:text-[#C4B6BE] uppercase tracking-wider font-medium">Hours</span>
          </div>
          <div class="flex flex-col bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] w-20 h-24 sm:w-28 sm:h-28 rounded-2xl items-center justify-center shadow-sm">
            <span class="text-3xl sm:text-4xl font-serif text-[#2D2226] dark:text-[#FDFBF7] tabular-nums leading-none mb-1.5">05</span>
            <span class="text-[10px] text-[#78666C] dark:text-[#C4B6BE] uppercase tracking-wider font-medium">Mins</span>
          </div>
          <div class="flex flex-col bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] w-20 h-24 sm:w-28 sm:h-28 rounded-2xl items-center justify-center shadow-sm animate-heartbeat">
            <span class="text-3xl sm:text-4xl font-serif text-[#E15B7B] dark:text-[#FBBF24] tabular-nums leading-none mb-1.5">42</span>
            <span class="text-[10px] text-[#78666C] dark:text-[#C4B6BE] uppercase tracking-wider font-medium">Secs</span>
          </div>
        </div>

        <p class="text-sm text-[#78666C] dark:text-[#C4B6BE] font-light max-w-lg mx-auto leading-relaxed mb-8">
          "Distance means so little when someone means so much." Countdowns give long-distance partners a concrete, glowing beacon to look forward to when missing each other is hard.
        </p>

        <!-- Preview Form -->
        <div class="card-cozy p-6 max-w-md mx-auto text-left shadow-sm bg-white dark:bg-[#1F1924]">
          <h4 class="font-serif text-base text-[#2D2226] dark:text-[#FDFBF7] mb-4">Set Target Reunion Date</h4>
          <div class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-1.5">Target Reunion Date</label>
              <input type="date" value="2026-07-27" class="w-full bg-[#FAF5EE] dark:bg-[#16131A] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl px-3.5 py-2.5 text-xs text-[#2D2226] dark:text-[#FDFBF7]" disabled />
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-1.5">Your City</label>
                <input type="text" value="San Francisco (SFO)" class="w-full bg-[#FAF5EE] dark:bg-[#16131A] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl px-3.5 py-2.5 text-xs text-[#2D2226] dark:text-[#FDFBF7]" disabled />
              </div>
              <div>
                <label class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-1.5">Partner's City</label>
                <input type="text" value="Mumbai (BOM)" class="w-full bg-[#FAF5EE] dark:bg-[#16131A] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl px-3.5 py-2.5 text-xs text-[#2D2226] dark:text-[#FDFBF7]" disabled />
              </div>
            </div>
          </div>
        </div>

        <div class="mt-10 flex justify-center">
          <a href="/" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#FAF5EE] dark:bg-[#1F1924] border border-[#F0E5DC] dark:border-[#3D3145] hover:border-[#E15B7B]/40 text-xs font-medium text-[#2D2226] dark:text-[#FDFBF7] transition-all">
            <span>← Back to Haven</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>
