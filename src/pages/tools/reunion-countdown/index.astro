---
// src/pages/tools/reunion-countdown/index.astro
import ToolLayout from "../../../layouts/ToolLayout.astro";
---

<ToolLayout
  title="Reunion Countdown | Will Meet Soon"
  description="Keep the spark alive and track the exact days, hours, and minutes until you're back in each other's arms."
  toolName="Reunion Countdown"
  toolDescription="Keep the spark alive and track the exact days, hours, and minutes until you're back in each other's arms."
>
  <span slot="hero-title">
    Countdown to your next <span class="bg-gradient-to-r from-[#f96bee] to-[#ea2261] bg-clip-text text-transparent font-medium">reunion date</span>
  </span>

  <div class="max-w-3xl mx-auto">
    <!-- Premium Preview Warning -->
    <div class="glow-border rounded-xl p-8 mb-8 text-center relative overflow-hidden">
      <!-- Ambient Gradient Indicator -->
      <div class="absolute inset-0 bg-[#f96bee]/5 z-0 pointer-events-none"></div>
      
      <div class="relative z-10">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-semibold bg-white/5 border border-white/10 text-neutral-300 uppercase tracking-widest mb-4">
          Prototype Preview
        </span>
        
        <!-- Mock Countdown Display -->
        <div class="flex justify-center gap-4 sm:gap-6 mb-8 text-center">
          <div class="flex flex-col bg-[#090a12]/80 border border-white/5 w-20 h-20 sm:w-24 sm:h-24 rounded-xl items-center justify-center backdrop-blur shadow-xl">
            <span class="text-2xl sm:text-3xl font-light text-white font-mono tabular-nums leading-none mb-1">28</span>
            <span class="text-[9px] text-[#61718a] uppercase tracking-wider font-light">Days</span>
          </div>
          <div class="flex flex-col bg-[#090a12]/80 border border-white/5 w-20 h-20 sm:w-24 sm:h-24 rounded-xl items-center justify-center backdrop-blur shadow-xl">
            <span class="text-2xl sm:text-3xl font-light text-white font-mono tabular-nums leading-none mb-1">14</span>
            <span class="text-[9px] text-[#61718a] uppercase tracking-wider font-light">Hours</span>
          </div>
          <div class="flex flex-col bg-[#090a12]/80 border border-white/5 w-20 h-20 sm:w-24 sm:h-24 rounded-xl items-center justify-center backdrop-blur shadow-xl">
            <span class="text-2xl sm:text-3xl font-light text-white font-mono tabular-nums leading-none mb-1">05</span>
            <span class="text-[9px] text-[#61718a] uppercase tracking-wider font-light">Mins</span>
          </div>
          <div class="flex flex-col bg-[#090a12]/80 border border-white/5 w-20 h-20 sm:w-24 sm:h-24 rounded-xl items-center justify-center backdrop-blur shadow-xl animate-pulse">
            <span class="text-2xl sm:text-3xl font-light text-white font-mono tabular-nums leading-none mb-1">42</span>
            <span class="text-[9px] text-[#61718a] uppercase tracking-wider font-light">Secs</span>
          </div>
        </div>

        <p class="text-sm text-neutral-300 font-light max-w-lg mx-auto leading-relaxed mb-6">
          "Distance means so little when someone means so much." Countdowns help long-distance couples visualize their upcoming airport reunions and coordinate travel plans.
        </p>

        <!-- Mock Form -->
        <div class="border border-white/5 bg-[#0b0c16]/50 rounded-lg p-6 max-w-md mx-auto text-left shadow-inner">
          <h4 class="text-xs font-semibold text-white uppercase tracking-wider mb-4">Set Your Target Reunion</h4>
          <div class="space-y-4">
            <div>
              <label class="block text-[10px] text-[#61718a] uppercase tracking-wider mb-1 font-medium">Reunion Date</label>
              <input type="date" value="2026-07-27" class="w-full bg-[#0b0c16] border border-white/10 rounded px-3 py-2 text-xs font-light text-white focus-ring" disabled />
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-[10px] text-[#61718a] uppercase tracking-wider mb-1 font-medium">Your City</label>
                <input type="text" value="San Francisco (SFO)" class="w-full bg-[#0b0c16] border border-white/10 rounded px-3 py-2 text-xs font-light text-white focus-ring" disabled />
              </div>
              <div>
                <label class="block text-[10px] text-[#61718a] uppercase tracking-wider mb-1 font-medium">Partner's City</label>
                <input type="text" value="Mumbai (BOM)" class="w-full bg-[#0b0c16] border border-white/10 rounded px-3 py-2 text-xs font-light text-white focus-ring" disabled />
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 flex justify-center">
          <a href="/" class="bg-white/5 border border-white/10 hover:bg-white/10 text-xs text-white font-medium px-6 py-2.5 rounded-lg transition-colors focus-ring">
            ← Back to Tools Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>
