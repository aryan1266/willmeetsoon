---
// src/pages/tools/gift-date-planner/index.astro
import ToolLayout from "../../../layouts/ToolLayout.astro";
import GiftingEngine from "../../../components/GiftingEngine.astro";
---

<ToolLayout
  title="Gift & Date Planner | Will Meet Soon"
  description="Plan shipping-optimized gifts, virtual date nights, and track timezone overlaps. Banish distance and connect deeply with your partner."
  toolName="Gift & Date Planner"
  toolDescription="Order locally-optimized gifts to bypass shipping custom duties, synchronize remote dates, and countdown to your next reunion."
>
  <span slot="hero-title">
    Plan the perfect <span class="bg-gradient-to-r from-[#533afd] via-[#f96bee] to-[#ea2261] bg-clip-text text-transparent font-medium font-medium">long-distance date</span> in 30 seconds
  </span>

  <!-- Main Gifting Recommendation Wizard -->
  <div class="mb-12">
    <GiftingEngine />
  </div>

  <!-- Aesthetic Value Proposition (Feature Cards) -->
  <section class="w-full border-t border-white/5 pt-12 mt-12 pb-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Card 1 -->
      <div class="glow-border rounded-xl p-6 transition-all duration-300">
        <div class="w-10 h-10 rounded-lg bg-[#533afd]/10 flex items-center justify-center text-[#533afd] mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </div>
        <h3 class="text-base font-medium text-white mb-2">Zero-Customs Shipping</h3>
        <p class="text-xs text-[#64748d] font-light leading-relaxed">
          Never get hit with unexpected 40% duty rates. We source items directly from online stores located inside your partner's country.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="glow-border rounded-xl p-6 transition-all duration-300">
        <div class="w-10 h-10 rounded-lg bg-[#f96bee]/10 flex items-center justify-center text-[#f96bee] mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-base font-medium text-white mb-2">Timezone Overlap Matcher</h3>
        <p class="text-xs text-[#64748d] font-light leading-relaxed">
          We calculate the exact offset between your cities and suggest the perfect windows of day where both of you are awake and free.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="glow-border rounded-xl p-6 transition-all duration-300">
        <div class="w-10 h-10 rounded-lg bg-[#ea2261]/10 flex items-center justify-center text-[#ea2261] mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
        </div>
        <h3 class="text-base font-medium text-white mb-2">Shared Date Rituals</h3>
        <p class="text-xs text-[#64748d] font-light leading-relaxed">
          From interactive cooking battles to long-term relocation maps, plan dates that build a real, shared future together.
        </p>
      </div>
    </div>
  </section>
</ToolLayout>
