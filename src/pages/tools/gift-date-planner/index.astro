---
// src/pages/tools/gift-date-planner/index.astro
import ToolLayout from "../../../layouts/ToolLayout.astro";
import GiftingEngine from "../../../components/GiftingEngine.astro";
---

<ToolLayout
  title="Care Package & Date Planner | Will Meet Soon"
  description="Plan border-free surprise gifts, discover cozy virtual date nights, and track mutual call windows for long-distance couples."
  toolName="Gift & Date Planner"
  toolDescription="Order locally-delivered care packages to completely bypass 40% customs fees, synchronize cozy date nights, and countdown together."
>
  <span slot="hero-title">
    Plan something sweet for <span class="bg-gradient-to-r from-[#E15B7B] via-[#FB923C] to-[#F59E0B] bg-clip-text text-transparent italic font-normal">your favorite person</span>
  </span>

  <!-- Main Gifting Recommendation Wizard -->
  <div class="mb-16">
    <GiftingEngine />
  </div>

  <!-- Lovable Value Proposition (Postcard Feature Cards) -->
  <section class="w-full border-t border-[#F0E5DC] dark:border-[#3D3145] pt-16 pb-8">
    <div class="text-center mb-10">
      <span class="stamp-badge text-xs text-[#E15B7B] dark:text-[#FBBF24]">Why Couples Love This</span>
      <h3 class="font-serif text-2xl sm:text-3xl text-[#2D2226] dark:text-[#FDFBF7] mt-3">
        Thoughtful care, zero logistics stress
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Card 1 -->
      <div class="card-cozy p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#FDE8EF] dark:bg-[#E15B7B]/20 flex items-center justify-center text-2xl mb-5">
            <span>📦</span>
          </div>
          <h4 class="font-serif text-lg font-medium text-[#2D2226] dark:text-[#FDFBF7] mb-2">Zero-Customs Sourcing</h4>
          <p class="text-xs sm:text-sm text-[#78666C] dark:text-[#C4B6BE] font-light leading-relaxed">
            Never get hit with unexpected 40% courier duty rates or package holds. We source items directly from online stores located right inside your partner's country.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#F0E5DC] dark:border-[#3D3145] text-[11px] font-medium text-[#E15B7B] dark:text-[#FBBF24]">
          Local delivery = happy surprises ✨
        </div>
      </div>

      <!-- Card 2 -->
      <div class="card-cozy p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#FFF1E6] dark:bg-[#FB923C]/20 flex items-center justify-center text-2xl mb-5">
            <span>☕</span>
          </div>
          <h4 class="font-serif text-lg font-medium text-[#2D2226] dark:text-[#FDFBF7] mb-2">Golden Hour Time Sync</h4>
          <p class="text-xs sm:text-sm text-[#78666C] dark:text-[#C4B6BE] font-light leading-relaxed">
            No more mental math with timezone offsets. We calculate your mutual free windows so one partner's morning coffee matches the other's bedtime tea.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#F0E5DC] dark:border-[#3D3145] text-[11px] font-medium text-[#FB923C]">
          Perfect morning & evening sync ☀️
        </div>
      </div>

      <!-- Card 3 -->
      <div class="card-cozy p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#FEF9C3] dark:bg-[#FBBF24]/20 flex items-center justify-center text-2xl mb-5">
            <span>🎨</span>
          </div>
          <h4 class="font-serif text-lg font-medium text-[#2D2226] dark:text-[#FDFBF7] mb-2">Shared Date Rituals</h4>
          <p class="text-xs sm:text-sm text-[#78666C] dark:text-[#C4B6BE] font-light leading-relaxed">
            Break free from dull FaceTime calls. Enjoy synchronized cooking battles, collaborative sketching, and playlist listening parties that feel truly shared.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#F0E5DC] dark:border-[#3D3145] text-[11px] font-medium text-[#F59E0B] dark:text-[#FBBF24]">
          Real memories across miles 💖
        </div>
      </div>
    </div>
  </section>
</ToolLayout>
