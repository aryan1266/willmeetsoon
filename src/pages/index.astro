---
import Layout from "../layouts/Layout.astro";
import GiftingEngine from "../components/GiftingEngine.astro";

// Country database mapping for SEO directory
const countriesMap = {
  us: { name: "United States" },
  in: { name: "India" },
  ca: { name: "Canada" },
  gb: { name: "United Kingdom" },
  au: { name: "Australia" },
  sg: { name: "Singapore" },
  de: { name: "Germany" },
  fr: { name: "France" },
  jp: { name: "Japan" },
  ru: { name: "Russia" }
};

// Generate all 90 long-distance couples routes for SEO directory
const countriesList = Object.keys(countriesMap);
const allCoupleRoutes = [];
for (const fromC of countriesList) {
  for (const toC of countriesList) {
    if (fromC !== toC) {
      allCoupleRoutes.push({
        fromCode: fromC.toUpperCase(),
        toCode: toC.toUpperCase(),
        path: `/gifts/${fromC}-to-${toC}`
      });
    }
  }
}
---

<Layout title="Will Meet Soon | Gifting & Date Night Planner for Long-Distance Couples">
  <div class="min-h-screen relative overflow-hidden flex flex-col justify-between">
    
    <!-- Stripe-inspired & Vercel-styled Grid and Gradient Mesh Background -->
    <div class="absolute inset-0 grid-overlay z-0 pointer-events-none"></div>
    <div class="gradient-blur-mesh"></div>

    <!-- Navigation Header -->
    <header class="w-full max-w-6xl mx-auto px-6 py-6 flex items-center justify-between relative z-10">
      <!-- Logo wordmark -->
      <a href="/" class="flex items-center gap-2 group focus-ring rounded-md">
        <!-- Vercel-like abstract connection logo -->
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-[#533afd] group-hover:text-white transition-colors duration-300" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
        </svg>
        <span class="text-sm font-semibold tracking-[0.1em] text-white uppercase font-display">
          Will Meet Soon
        </span>
      </a>
      
      <!-- Small premium tag -->
      <div class="hidden sm:flex items-center gap-4 text-xs font-light text-[#61718a]">
        <span class="hover:text-white transition-colors cursor-default select-none">willmeetsoon.com</span>
        <span class="w-1.5 h-1.5 bg-[#533afd] rounded-full animate-ping"></span>
        <span class="text-emerald-400 font-medium bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">v1.0 Live</span>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow flex flex-col justify-center relative z-10 py-12">
      <!-- Hero Section -->
      <div class="w-full max-w-4xl mx-auto px-6 text-center mb-10">
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/5 rounded-full border border-white/10 mb-6 hover:border-white/20 transition-all">
          <span class="w-2 h-2 rounded-full bg-[#ea2261]"></span>
          <span class="text-[10px] md:text-xs font-medium text-neutral-300 tracking-wider uppercase">
            Banish the Distance
          </span>
        </div>

        <!-- Headline using Sohne/Inter light display typography with negative tracking -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-light text-white tracking-[-1.8px] leading-[1.05] mb-6 max-w-3xl mx-auto text-balance">
          Plan the perfect <span class="bg-gradient-to-r from-[#533afd] via-[#f96bee] to-[#ea2261] bg-clip-text text-transparent font-medium">long-distance date</span> in 30 seconds
        </h1>

        <!-- Subheading -->
        <p class="text-base md:text-lg font-light text-[#64748d] max-w-xl mx-auto leading-relaxed text-pretty">
          Order locally-optimized gifts to bypass shipping custom duties, synchronize remote dates, and countdown to your next reunion.
        </p>
      </div>

      <!-- Main Recommendation Wizard -->
      <GiftingEngine />

      <!-- Aesthetic Value Proposition (Feature Cards) -->
      <section class="w-full max-w-6xl mx-auto px-6 py-12 border-t border-white/5 mt-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- Card 1 -->
          <div class="glow-border rounded-xl p-6 transition-all duration-300">
            <div class="w-10 h-10 rounded-lg bg-[#533afd]/10 flex items-center justify-center text-[#533afd] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
              </svg>
            </div>
            <h3 class="text-base font-medium text-white mb-2">Zero-Customs Shipping</h3>
            <p class="text-xs text-[#64748d] font-light leading-relaxed">
              Never get hit with unexpected 40% duty rates. We source items directly from online stores located inside your partner's country.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="glow-border rounded-xl p-6 transition-all duration-300">
            <div class="w-10 h-10 rounded-lg bg-[#f96bee]/10 flex items-center justify-center text-[#f96bee] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-base font-medium text-white mb-2">Timezone Overlap Matcher</h3>
            <p class="text-xs text-[#64748d] font-light leading-relaxed">
              We calculate the exact offset between your cities and suggest the perfect windows of day where both of you are awake and free.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="glow-border rounded-xl p-6 transition-all duration-300">
            <div class="w-10 h-10 rounded-lg bg-[#ea2261]/10 flex items-center justify-center text-[#ea2261] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
            </div>
            <h3 class="text-base font-medium text-white mb-2">Shared Date Rituals</h3>
            <p class="text-xs text-[#64748d] font-light leading-relaxed">
              From interactive cooking battles to long-term relocation maps, plan dates that build a real, shared future together.
            </p>
          </div>

        </div>
      </section>
    </main>

    <!-- Footer conforming to the light specifications but in dark/navy theme -->
    <footer class="border-t border-white/5 py-12 bg-[#090a12]/80 relative z-10">
      <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <div class="flex items-center gap-2 mb-4">
            <span class="text-xs font-semibold tracking-wider text-white uppercase font-display">Will Meet Soon</span>
          </div>
          <p class="text-xs text-[#64748d] max-w-sm leading-relaxed font-light">
            Connecting hearts across continents. Helping long distance relationships survive, thrive, and close the distance with premium tools.
          </p>
        </div>
        
        <div>
          <h4 class="text-xs font-medium text-white uppercase tracking-wider mb-4 font-display">Resources</h4>
          <ul class="space-y-2 text-xs text-[#61718a] font-light">
            <li><a href="https://www.amazon.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Amazon Logistics</a></li>
            <li><a href="https://www.paired.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Paired Couples App</a></li>
            <li><a href="https://www.cozymeal.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Cozymeal Cooking</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-xs font-medium text-white uppercase tracking-wider mb-4 font-display">Site Links</h4>
          <ul class="space-y-2 text-xs text-[#61718a] font-light">
            <li><a href="/" class="hover:text-white transition-colors">Home Planner</a></li>
            <li><span class="cursor-default hover:text-white transition-colors">Privacy Policy</span></li>
            <li><a href="https://willmeetsoon.com" class="hover:text-white transition-colors">willmeetsoon.com</a></li>
          </ul>
        </div>
      </div>

      <!-- SEO directory of all 90 routes -->
      <div class="max-w-6xl mx-auto px-6 mt-12 pt-12 border-t border-white/5">
        <h4 class="text-xs font-medium text-white uppercase tracking-wider mb-6 font-display">Explore Long Distance Portals</h4>
        <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-9 gap-x-4 gap-y-3 text-[10px] text-[#61718a] font-light">
          {allCoupleRoutes.map(route => (
            <a href={route.path} class="hover:text-white transition-colors whitespace-nowrap">
              {route.fromCode} → {route.toCode} Couples
            </a>
          ))}
        </div>
      </div>

      <div class="max-w-6xl mx-auto px-6 mt-12 pt-6 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-[#61718a] font-light">
        <p>&copy; 2026 Will Meet Soon. All rights reserved.</p>
        <p class="tabular-nums">Dynamic SEO Routes for 100 couples channels.</p>
      </div>
    </footer>

  </div>
</Layout>
