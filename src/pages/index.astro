---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";

// Tool card content definition
const tools = [
  {
    id: "gift-date-planner",
    name: "Gift & Date Planner",
    description: "Order locally-optimized gifts to bypass shipping custom duties, synchronize remote dates, and countdown to your next reunion.",
    status: "live",
    path: "/tools/gift-date-planner",
    icon: "M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z",
    color: "from-[#533afd] to-[#f96bee]"
  },
  {
    id: "reunion-countdown",
    name: "Reunion Countdown",
    description: "Keep the spark alive and track the exact days, hours, and minutes until you're back in each other's arms.",
    status: "soon",
    path: "/tools/reunion-countdown",
    icon: "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5",
    color: "from-[#f96bee] to-[#ea2261]"
  },
  {
    id: "time-overlap-planner",
    name: "Time Overlap Planner",
    description: "Visualize your schedules side-by-side to find the perfect daily windows where both of you are awake and free.",
    status: "soon",
    path: "/tools/time-overlap-planner",
    icon: "M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z",
    color: "from-[#533afd] to-[#ea2261]"
  },
  {
    id: "movie-night-planner",
    name: "Movie Night Planner",
    description: "Synchronize your streaming queues and video chats for a seamless lag-free virtual cinema experience.",
    status: "soon",
    path: "/tools/movie-night-planner",
    icon: "M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z M9 3.75v16.5M15 3.75v16.5M3.75 9h16.5M3.75 15h16.5",
    color: "from-[#ea2261] to-[#f96bee]"
  }
];
---

<Layout title="Will Meet Soon | Multi-Tool Platform for Long-Distance Couples">
  <div class="py-12">
    <!-- Hero Section -->
    <div class="w-full max-w-4xl mx-auto px-6 text-center mb-16">
      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/5 rounded-full border border-white/10 mb-6 hover:border-white/20 transition-all">
        <span class="w-2 h-2 rounded-full bg-[#ea2261]"></span>
        <span class="text-[10px] md:text-xs font-medium text-neutral-300 tracking-wider uppercase">
          Banish the Distance
        </span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-light text-white tracking-[-1.8px] leading-[1.05] mb-6 max-w-3xl mx-auto text-balance">
        Stay connected, <span class="bg-gradient-to-r from-[#533afd] via-[#f96bee] to-[#ea2261] bg-clip-text text-transparent font-medium">no matter the distance</span>
      </h1>

      <!-- Subheading -->
      <p class="text-base md:text-lg font-light text-[#64748d] max-w-xl mx-auto leading-relaxed text-pretty">
        A premium suite of tools designed to help long-distance couples bridge the gap. Settle timezone borders, sync remote dates, and send customs-optimized gifts.
      </p>
    </div>

    <!-- Grid of Tools -->
    <div class="w-full max-w-5xl mx-auto px-6 mb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {tools.map(tool => (
          <div class="glow-border rounded-xl p-8 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <!-- Tool Header -->
              <div class="flex items-center justify-between mb-6">
                <!-- Icon and Gradient Blur Background behind it -->
                <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center relative overflow-hidden">
                  <div class={`absolute inset-0 bg-gradient-to-br ${tool.color} opacity-10 blur-sm`}></div>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-white relative z-10" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={tool.icon} />
                  </svg>
                </div>
                
                <!-- Status Badge -->
                {tool.status === 'live' ? (
                  <span class="text-[10px] text-emerald-400 font-semibold tracking-wider bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.75 rounded-full uppercase">
                    Active
                  </span>
                ) : (
                  <span class="text-[10px] text-neutral-400 font-medium tracking-wider bg-white/5 border border-white/10 px-2.5 py-0.75 rounded-full uppercase">
                    Coming Soon
                  </span>
                )}
              </div>

              <!-- Title -->
              <h3 class="text-xl font-medium text-white mb-3 group-hover:text-white transition-colors">
                {tool.name}
              </h3>

              <!-- Description -->
              <p class="text-sm text-[#64748d] font-light leading-relaxed mb-8">
                {tool.description}
              </p>
            </div>

            <!-- Button / Link -->
            <a 
              href={tool.path} 
              class={`inline-flex items-center justify-center px-4 py-2.5 rounded-lg text-xs font-semibold tracking-wider transition-all duration-300 focus-ring ${
                tool.status === 'live' 
                  ? 'bg-[#533afd] text-white hover:bg-[#665efd] shadow-lg shadow-[#533afd]/20' 
                  : 'bg-white/5 text-[#61718a] hover:bg-white/10 border border-white/5'
              }`}
            >
              {tool.status === 'live' ? 'Open Tool' : 'Preview Tool'}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 ml-1.5 transition-transform duration-300 group-hover:translate-x-0.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Dynamic Value Statement (Call to Action placeholder) -->
    <section class="w-full max-w-5xl mx-auto px-6 py-12 border-t border-white/5 mt-8 text-center">
      <h4 class="text-sm font-semibold tracking-widest text-[#61718a] uppercase mb-4">Close the distance</h4>
      <p class="text-xs text-[#64748d] max-w-lg mx-auto font-light leading-relaxed">
        Will Meet Soon is built on the philosophy that distance is just a temporary state. Our software aids the emotional connection of relationships until you meet next.
      </p>
    </section>
  </div>
</Layout>
