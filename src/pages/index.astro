---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";

// Tool suite definition: Gift & Date Planner is the active centerpiece
const upcomingTools = [
  {
    id: "reunion-countdown",
    name: "Reunion Countdown",
    description: "Track the exact days, hours, and heartbeats until you're finally running into each other's arms at the airport terminal.",
    icon: "⏳",
    badge: "Crafting with Love 🌸",
    badgeColor: "bg-[#FEF9C3] text-[#B45309] border-[#FDE047] dark:bg-[#FBBF24]/15 dark:text-[#FBBF24] dark:border-[#FBBF24]/30",
    statusNote: "Coming soon for couples"
  },
  {
    id: "time-overlap-planner",
    name: "Time Overlap Planner",
    description: "Visualize both daily rhythms side-by-side. Discover that golden window where one is waking to coffee and the other is unwinding.",
    icon: "☀️",
    badge: "In Development ☕",
    badgeColor: "bg-[#FFF1E6] text-[#C2410C] border-[#FED7AA] dark:bg-[#FB923C]/15 dark:text-[#FB923C] dark:border-[#FB923C]/30",
    statusNote: "Coming soon for couples"
  },
  {
    id: "movie-night-planner",
    name: "Movie Night Planner",
    description: "Couch cuddles across oceans. Synchronize queues and video feeds so you laugh, cry, and react at the exact same millisecond.",
    icon: "🍿",
    badge: "In the Works 🎬",
    badgeColor: "bg-[#F3E8FF] text-[#7E22CE] border-[#E9D5FF] dark:bg-[#A855F7]/15 dark:text-[#C084FC] dark:border-[#A855F7]/30",
    statusNote: "Coming soon for couples"
  }
];
---

<Layout 
  title="Will Meet Soon | A Lovable Comfort Haven for Long-Distance Couples"
  description="A gentle haven for couples across distance. Plan customs-free surprise gifts, discover synchronized connection flowcharts, and close the miles."
>
  <div class="py-12 md:py-20">
    <!-- Hero Section with Generous Open Spaces -->
    <div class="w-full max-w-4xl mx-auto px-6 text-center mb-16 relative">
      
      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 dark:bg-[#261E2C]/90 rounded-full border border-[#F0E5DC] dark:border-[#3D3145] shadow-sm mb-8 hover:scale-105 transition-all duration-300">
        <span class="text-sm">💌</span>
        <span class="text-xs font-medium text-[#78666C] dark:text-[#C4B6BE] tracking-wide">
          A gentle comfort haven for long-distance love
        </span>
      </div>

      <!-- Main Headline in Warm Fraunces Serif -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-serif font-normal text-[#2D2226] dark:text-[#FDFBF7] tracking-tight leading-[1.08] mb-8 max-w-3xl mx-auto text-balance">
        Stay close in heart, <br class="hidden sm:inline" />
        <span class="italic bg-gradient-to-r from-[#E15B7B] via-[#FB923C] to-[#F59E0B] bg-clip-text text-transparent font-medium">
          no matter the distance
        </span>
      </h1>

      <!-- Heartfelt Subheading -->
      <p class="text-base sm:text-lg md:text-xl font-light text-[#78666C] dark:text-[#C4B6BE] max-w-2xl mx-auto leading-relaxed text-pretty mb-10">
        A warm sanctuary built specifically for couples separated by miles and timezones. Zero ads, zero spam, and free forever.
      </p>

      <!-- Primary Action CTA Button -->
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/tools/gift-date-planner" 
          class="btn-lovable px-8 py-4 bg-gradient-to-r from-[#E15B7B] to-[#F472B6] text-white text-sm shadow-md hover:shadow-lg focus-ring text-base font-medium flex items-center gap-3 group"
        >
          <span>Open Gift & Date Planner</span>
          <span class="group-hover:scale-125 transition-transform duration-300">🎁</span>
        </a>
      </div>
    </div>

    <!-- CENTERPIECE ACTIVE TOOL: Gift & Date Planner Hero Showcase -->
    <div class="w-full max-w-4xl mx-auto px-6 mb-20">
      <div class="card-cozy p-8 sm:p-12 relative overflow-hidden bg-gradient-to-br from-[#FFFDF9] via-[#FAF5EE] to-[#FDE8EF]/40 dark:from-[#261E2C] dark:via-[#1F1924] dark:to-[#2B1B2A] border-2 border-[#FDE8EF] dark:border-[#3D3145] shadow-lg">
        <!-- Soft decorative glow -->
        <div class="absolute -top-16 -right-16 w-64 h-64 rounded-full bg-[#E15B7B]/10 dark:bg-[#FBBF24]/10 blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
          <div class="max-w-xl">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E15B7B] text-white text-xs font-semibold shadow-sm mb-4">
              <span>💖</span>
              <span>Available Now · Ready to Use</span>
            </div>
            
            <h2 class="font-serif text-3xl sm:text-4xl text-[#2D2226] dark:text-[#FDFBF7] tracking-tight mb-3">
              Gift & Date Connection Planner
            </h2>

            <p class="text-sm sm:text-base text-[#78666C] dark:text-[#C4B6BE] font-light leading-relaxed mb-6">
              Skip 40% customs duty traps and painful courier delays. Powered by our Gemini AI concierge, discover 1 deeply personalized gift sourced locally in their country, plus a synchronized flowchart of your day's calls and dates.
            </p>

            <div class="flex flex-wrap items-center gap-4 text-xs text-[#78666C] dark:text-[#C4B6BE] mb-6">
              <span class="flex items-center gap-1.5">
                <span class="text-[#E15B7B] dark:text-[#FBBF24]">✔</span> 100% Customs-Free Local Sourcing
              </span>
              <span class="flex items-center gap-1.5">
                <span class="text-[#E15B7B] dark:text-[#FBBF24]">✔</span> Synchronized Dual Timezone Flowchart
              </span>
              <span class="flex items-center gap-1.5">
                <span class="text-[#E15B7B] dark:text-[#FBBF24]">✔</span> No Product Links or Ads
              </span>
            </div>

            <a 
              href="/tools/gift-date-planner" 
              class="btn-lovable inline-flex items-center gap-2 bg-[#E15B7B] text-white px-7 py-3 text-xs sm:text-sm font-semibold shadow-md hover:bg-[#CC4B6B]"
            >
              <span>Launch Planner</span>
              <span>🌸</span>
            </a>
          </div>

          <!-- Cute Visual Graphic -->
          <div class="w-full md:w-auto flex justify-center">
            <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-3xl bg-[#FFFDF9] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] flex flex-col items-center justify-center p-6 shadow-md text-center">
              <span class="text-5xl sm:text-6xl mb-2 select-none animate-float">🎁</span>
              <span class="text-[11px] font-medium text-[#78666C] dark:text-[#C4B6BE]">Free AI Concierge</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- UPCOMING TOOLS SUITE: In Development with Love -->
    <div id="tools-section" class="w-full max-w-4xl mx-auto px-6 mb-24">
      <div class="text-center mb-10">
        <span class="stamp-badge text-xs text-[#FB923C] dark:text-[#FBBF24]">Future Suite for Couples</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-[#2D2226] dark:text-[#FDFBF7] mt-2">
          More tools in the works
        </h2>
        <p class="text-xs sm:text-sm text-[#78666C] dark:text-[#C4B6BE] font-light max-w-md mx-auto mt-1">
          We're thoughtfully designing these upcoming tools to make your distance feel shorter every single day.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {upcomingTools.map(tool => (
          <div class="card-cozy p-6 sm:p-7 flex flex-col justify-between relative bg-white/70 dark:bg-[#1F1924]/70 border border-[#F0E5DC] dark:border-[#3D3145]">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-[#FAF5EE] dark:bg-[#16131A] border border-[#F0E5DC] dark:border-[#3D3145] flex items-center justify-center text-2xl shadow-inner">
                  <span>{tool.icon}</span>
                </div>
                <span class={`text-[10px] font-medium tracking-wide px-2.5 py-1 rounded-full border ${tool.badgeColor}`}>
                  {tool.badge}
                </span>
              </div>

              <h3 class="font-serif text-lg font-normal text-[#2D2226] dark:text-[#FDFBF7] mb-2">
                {tool.name}
              </h3>

              <p class="text-xs text-[#78666C] dark:text-[#C4B6BE] font-light leading-relaxed mb-6">
                {tool.description}
              </p>
            </div>

            <div class="pt-3 border-t border-[#F0E5DC] dark:border-[#3D3145] flex items-center justify-between text-[11px] text-[#78666C]/70 dark:text-[#C4B6BE]/70 italic">
              <span>{tool.statusNote}</span>
              <span>💌</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Heartwarming Comfort Banner (A Soft Place to Land) -->
    <section class="w-full max-w-4xl mx-auto px-6 py-8">
      <div class="card-cozy p-8 sm:p-12 text-center bg-gradient-to-b from-[#FFFDF9] to-[#FAF5EE] dark:from-[#261E2C] dark:to-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] relative overflow-hidden">
        <!-- Decorative heart in background -->
        <div class="absolute right-6 -bottom-6 text-7xl opacity-10 dark:opacity-5 select-none pointer-events-none">
          💖
        </div>
        <div class="absolute left-6 -top-6 text-7xl opacity-10 dark:opacity-5 select-none pointer-events-none">
          🕊️
        </div>

        <span class="text-2xl mb-4 inline-block">🌸</span>
        <h3 class="font-serif text-2xl sm:text-3xl text-[#2D2226] dark:text-[#FDFBF7] mb-4">
          "Distance means so little when someone means so much."
        </h3>
        <p class="text-xs sm:text-sm text-[#78666C] dark:text-[#C4B6BE] max-w-xl mx-auto font-light leading-relaxed mb-6">
          Will Meet Soon was created with one simple conviction: love should never feel trapped in logistics. Every tool here exists to protect your warmth, make your days easier, and turn the waiting into gentle anticipation.
        </p>
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-[#E15B7B] dark:text-[#FBBF24]">
          <span>✨</span>
          <span>You two are closer with every passing second.</span>
        </div>
      </div>
    </section>
  </div>
</Layout>
