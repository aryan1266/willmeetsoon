---
import Layout from "../../layouts/Layout.astro";
import GiftingEngine from "../../components/GiftingEngine.astro";

// getStaticPaths generates routes at build time for all 100 possible country-pair combinations
export async function getStaticPaths() {
  const countriesList = ["US", "IN", "CA", "GB", "AU", "SG", "DE", "FR", "JP", "RU"];
  const paths = [];
  
  for (const yourCountry of countriesList) {
    for (const partnerCountry of countriesList) {
      paths.push({
        params: { 
          yourCountry: yourCountry.toLowerCase(), 
          partnerCountry: partnerCountry.toLowerCase() 
        }
      });
    }
  }
  
  return paths;
}

const { yourCountry, partnerCountry } = Astro.params;

// Country database mapping for static metadata
const countriesMap = {
  us: { name: "United States", tzName: "EST", tzOffset: -5, currency: "$", currencyName: "USD" },
  in: { name: "India", tzName: "IST", tzOffset: 5.5, currency: "₹", currencyName: "INR" },
  ca: { name: "Canada", tzName: "EST", tzOffset: -5, currency: "C$", currencyName: "CAD" },
  gb: { name: "United Kingdom", tzName: "GMT", tzOffset: 0, currency: "£", currencyName: "GBP" },
  au: { name: "Australia", tzName: "AEST", tzOffset: 10, currency: "A$", currencyName: "AUD" },
  sg: { name: "Singapore", tzName: "SGT", tzOffset: 8, currency: "S$", currencyName: "SGD" },
  de: { name: "Germany", tzName: "CET", tzOffset: 1, currency: "€", currencyName: "EUR" },
  fr: { name: "France", tzName: "CET", tzOffset: 1, currency: "€", currencyName: "EUR" },
  jp: { name: "Japan", tzName: "JST", tzOffset: 9, currency: "¥", currencyName: "JPY" },
  ru: { name: "Russia", tzName: "MSK", tzOffset: 3, currency: "₽", currencyName: "RUB" }
};

const yourCountryCode = yourCountry.toUpperCase();
const partnerCountryCode = partnerCountry.toUpperCase();

const countryA = countriesMap[yourCountry];
const countryB = countriesMap[partnerCountry];

// Generate all 90 long-distance couples routes for SEO directory
const countriesList = Object.keys(countriesMap);
const allCoupleRoutes = [];
for (const fromC of countriesList) {
  for (const toC of countriesList) {
    if (fromC !== toC) {
      allCoupleRoutes.push({
        fromCode: fromC.toUpperCase(),
        toCode: toC.toUpperCase(),
        path: `/gifts/${fromC}-to-${toC}`
      });
    }
  }
}

const titleText = `Gift Ideas for ${countryA.name} → ${countryB.name} Couples`;
const seoDescription = `Explore shipping-optimized gifts, virtual date nights, and timezone call times for couples in ${countryA.name} and ${countryB.name}. Banish distance with Will Meet Soon.`;

// Timezone best call schedules mapping for static rendering
const tzOverlapMap = {
