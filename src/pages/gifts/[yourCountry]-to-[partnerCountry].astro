// Compute difference and times statically
const keyStr = `${yourCountryCode}-${partnerCountryCode}`;
const reverseKeyStr = `${partnerCountryCode}-${yourCountryCode}`;

let staticTimeA = "9:00 AM - 10:00 PM";
let staticTimeB = "9:00 AM - 10:00 PM";
let staticOverlapNote = "Fully synchronized local schedules";

if (yourCountryCode === partnerCountryCode) {
  staticTimeA = "9:00 AM - 10:00 PM";
  staticTimeB = "9:00 AM - 10:00 PM";
  staticOverlapNote = "You live in the same country! Pick any local time.";
} else if (tzOverlapMap[keyStr]) {
  staticTimeA = tzOverlapMap[keyStr].timeA;
  staticTimeB = tzOverlapMap[keyStr].timeB;
  staticOverlapNote = tzOverlapMap[keyStr].note;
} else if (tzOverlapMap[reverseKeyStr]) {
  staticTimeA = tzOverlapMap[reverseKeyStr].timeB;
  staticTimeB = tzOverlapMap[reverseKeyStr].timeA;
  staticOverlapNote = tzOverlapMap[reverseKeyStr].note;
} else {
  const diff = Math.abs(countryA.tzOffset - countryB.tzOffset);
  staticTimeA = "7:00 PM - 10:00 PM";
  const startHour = (19 - diff + 24) % 24;
  const endHour = (22 - diff + 24) % 24;
  const formatHour = (h) => `${h % 12 || 12}:00 ${h >= 12 ? 'PM' : 'AM'}`;
  staticTimeB = `${formatHour(startHour)} - ${formatHour(endHour)}`;
  staticOverlapNote = `Adjusted call hours with a ${diff}h timezone difference.`;
}

// Time shifting helper (adds minutes to AM/PM time strings)
function addMinutesToTime(timeStr, minsToAdd) {
  if (!timeStr) return "";
  const match = timeStr.match(/(\d+):(\d+)\s*(AM|PM)/i);
  if (!match) return timeStr;
  
  let hour = parseInt(match[1]);
  const min = parseInt(match[2]);
  const ampm = match[3].toUpperCase();
  
  if (ampm === "PM" && hour !== 12) hour += 12;
  if (ampm === "AM" && hour === 12) hour = 0;
  
  let totalMins = hour * 60 + min + minsToAdd;
  totalMins = (totalMins + 24 * 60) % (24 * 60);
  
  const newHour24 = Math.floor(totalMins / 60);
  const newMin = totalMins % 60;
  
  const newAmpm = newHour24 >= 12 ? "PM" : "AM";
  const newHour12 = newHour24 % 12 || 12;
  
  return `${newHour12}:${String(newMin).padStart(2, '0')} ${newAmpm}`;
}

const staticTimeAStart = staticTimeA.split(" - ")[0];
const staticTimeBStart = staticTimeB.split(" - ")[0];

const staticTimeA30 = addMinutesToTime(staticTimeAStart, 30);
const staticTimeB30 = addMinutesToTime(staticTimeBStart, 30);

const staticTimeA45 = addMinutesToTime(staticTimeAStart, 45);
const staticTimeB45 = addMinutesToTime(staticTimeBStart, 45);

const staticTimeA90 = addMinutesToTime(staticTimeAStart, 90);
const staticTimeB90 = addMinutesToTime(staticTimeBStart, 90);

const staticTimeA210 = addMinutesToTime(staticTimeAStart, 210);
const staticTimeB210 = addMinutesToTime(staticTimeBStart, 210);

const tzDifferenceHours = Math.abs(countryA.tzOffset - countryB.tzOffset);
