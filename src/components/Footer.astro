---
// src/components/Footer.astro
import { countries } from "../data/countries";

// Generate all 90 long-distance couples routes for SEO directory dynamically
const countriesList = Object.keys(countries);
const allCoupleRoutes = [];
for (const fromC of countriesList) {
  for (const toC of countriesList) {
    if (fromC !== toC) {
      allCoupleRoutes.push({
        fromCode: fromC.toUpperCase(),
        toCode: toC.toUpperCase(),
        path: `/gifts/${fromC.toLowerCase()}-to-${toC.toLowerCase()}`
      });
    }
  }
}
---

<footer class="border-t border-[#F0E5DC] dark:border-[#3D3145] py-16 bg-[#FAF5EE] dark:bg-[#1A141F] relative z-10 mt-auto w-full transition-colors duration-400">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-10">
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-xl">💌</span>
        <span class="font-serif text-base font-semibold text-[#2D2226] dark:text-[#FDFBF7]">Will Meet Soon</span>
      </div>
      <p class="text-xs text-[#78666C] dark:text-[#C4B6BE] max-w-sm leading-relaxed font-light">
        A gentle, loving corner created for couples separated by oceans, borders, and timezones. Because true love isn't bound by distance.
      </p>
      <div class="pt-2">
        <span class="stamp-badge inline-flex items-center gap-1.5 text-xs text-[#E15B7B] dark:text-[#FBBF24]">
          <span>🫂</span> Until the next airport hug
        </span>
      </div>
    </div>
    
    <div>
      <h4 class="text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-4 font-serif">Thoughtful Reads</h4>
      <ul class="space-y-2.5 text-xs text-[#78666C] dark:text-[#C4B6BE] font-light">
        <li><a href="/guides" class="hover:text-[#E15B7B] dark:hover:text-[#FBBF24] transition-colors">Surviving the First 6 Months</a></li>
        <li><a href="/guides" class="hover:text-[#E15B7B] dark:hover:text-[#FBBF24] transition-colors">Creative Virtual Date Rituals</a></li>
        <li><a href="/guides" class="hover:text-[#E15B7B] dark:hover:text-[#FBBF24] transition-colors">Gifting Internationally with Zero Customs</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-4 font-serif">Explore the Haven</h4>
      <ul class="space-y-2.5 text-xs text-[#78666C] dark:text-[#C4B6BE] font-light">
        <li><a href="/" class="hover:text-[#E15B7B] dark:hover:text-[#FBBF24] transition-colors">Home Haven</a></li>
        <li><a href="/tools/gift-date-planner" class="hover:text-[#E15B7B] dark:hover:text-[#FBBF24] transition-colors">Care Package & Date Planner</a></li>
        <li><a href="/tools/reunion-countdown" class="hover:text-[#E15B7B] dark:hover:text-[#FBBF24] transition-colors">Reunion Countdown</a></li>
        <li><a href="/about" class="hover:text-[#E15B7B] dark:hover:text-[#FBBF24] transition-colors">Our Story & Mission</a></li>
      </ul>
    </div>
  </div>

  <!-- SEO directory of all 90 routes with soft pill tags -->
  <div class="max-w-6xl mx-auto px-6 mt-14 pt-10 border-t border-[#F0E5DC] dark:border-[#3D3145]">
    <h4 class="text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-5 font-serif flex items-center gap-2">
      <span>🌏</span> Long Distance Portals Across the Globe
    </h4>
    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-9 gap-2 text-[11px] text-[#78666C] dark:text-[#C4B6BE] font-light">
      {allCoupleRoutes.map(route => (
        <a 
          href={route.path} 
          class="px-2 py-1 rounded-lg bg-white/70 dark:bg-[#261E2C]/70 border border-[#F0E5DC] dark:border-[#3D3145] hover:border-[#E15B7B]/50 hover:text-[#E15B7B] dark:hover:text-[#FBBF24] transition-all text-center whitespace-nowrap overflow-hidden text-ellipsis"
        >
          {route.fromCode} ♡ {route.toCode}
        </a>
      ))}
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 mt-10 pt-6 border-t border-[#F0E5DC] dark:border-[#3D3145] flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-[#78666C] dark:text-[#C4B6BE] font-light">
    <p>&copy; 2026 Will Meet Soon. Built with gentle love for couples everywhere.</p>
    <p class="flex items-center gap-1.5">
      <span>✨</span> <span>Distance is just geography when hearts are close.</span>
    </p>
  </div>
</footer>
