---
// src/components/Navbar.astro
const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === '/') {
    return currentPath === '/' 
      ? 'text-[#E15B7B] dark:text-[#FBBF24] font-semibold bg-[#FDE8EF]/80 dark:bg-[#FBBF24]/10 rounded-full px-3.5 py-1.5' 
      : 'text-[#78666C] dark:text-[#C4B6BE] hover:text-[#E15B7B] dark:hover:text-[#FBBF24] px-3.5 py-1.5 rounded-full hover:bg-[#FDE8EF]/40 dark:hover:bg-white/5 transition-all';
  }
  return currentPath.startsWith(path) 
    ? 'text-[#E15B7B] dark:text-[#FBBF24] font-semibold bg-[#FDE8EF]/80 dark:bg-[#FBBF24]/10 rounded-full px-3.5 py-1.5' 
    : 'text-[#78666C] dark:text-[#C4B6BE] hover:text-[#E15B7B] dark:hover:text-[#FBBF24] px-3.5 py-1.5 rounded-full hover:bg-[#FDE8EF]/40 dark:hover:bg-white/5 transition-all';
};
---

<header class="sticky top-0 z-50 w-full bg-[#FFFDF9]/85 dark:bg-[#16131A]/85 backdrop-blur-md border-b border-[#F0E5DC] dark:border-[#3D3145] transition-colors duration-400">
  <div class="max-w-6xl mx-auto px-6 py-3.5 flex items-center justify-between">
    <!-- Lovable Logo Wordmark -->
    <a href="/" class="flex items-center gap-2.5 group focus-ring rounded-full px-2 py-1 z-50">
      <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[#FDE8EF] to-[#FFEDD5] dark:from-[#FBBF24]/20 dark:to-[#E15B7B]/20 flex items-center justify-center text-lg shadow-sm group-hover:scale-105 transition-transform duration-300">
        <span class="animate-heartbeat inline-block">💖</span>
      </div>
      <div class="flex flex-col">
        <span class="font-serif text-lg font-semibold text-[#2D2226] dark:text-[#FDFBF7] tracking-tight group-hover:text-[#E15B7B] dark:group-hover:text-[#FBBF24] transition-colors">
          Will Meet Soon
        </span>
        <span class="text-[10px] text-[#78666C] dark:text-[#C4B6BE] -mt-1 font-normal tracking-wide">
          cozy long-distance haven
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-2 text-xs font-medium tracking-wide z-50" aria-label="Main Navigation">
      <a href="/" class={`transition-all duration-200 ${isActive('/')}`}>Home</a>
      
      <!-- Tools Dropdown Trigger -->
      <div class="relative group py-1">
        <button class={`flex items-center gap-1.5 cursor-pointer transition-all duration-200 ${isActive('/tools')}`} aria-expanded="false" aria-haspopup="true">
          <span>Couples Tools</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-2.5 h-2.5 opacity-60 group-hover:rotate-180 transition-transform duration-300">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <!-- Dropdown Menu -->
        <div class="absolute left-0 mt-2 w-68 rounded-2xl opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 border border-[#F0E5DC] dark:border-[#3D3145] bg-[#FFFDF9]/95 dark:bg-[#261E2C]/95 backdrop-blur-xl p-2.5 shadow-xl z-50">
          <a href="/tools/gift-date-planner" class="flex items-start gap-2.5 px-3 py-2.5 rounded-xl bg-[#FDE8EF]/40 dark:bg-white/5 hover:bg-[#FDE8EF]/80 dark:hover:bg-white/10 transition-colors group/item">
            <span class="text-base mt-0.5">🎁</span>
            <div class="flex flex-col">
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-semibold text-[#E15B7B] dark:text-[#FBBF24]">Gift & Date Planner</span>
                <span class="text-[9px] bg-[#E15B7B] text-white px-1.5 py-0.2 rounded-full font-bold">LIVE</span>
              </div>
              <span class="text-[10px] text-[#78666C] dark:text-[#C4B6BE]">No-customs delivery & cute dates</span>
            </div>
          </a>
          <div class="flex items-start gap-2.5 px-3 py-2 rounded-xl opacity-60">
            <span class="text-base mt-0.5">⏳</span>
            <div class="flex flex-col">
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-medium text-[#2D2226] dark:text-[#FDFBF7]">Reunion Countdown</span>
                <span class="text-[9px] bg-[#FAF5EE] dark:bg-[#16131A] text-[#78666C] dark:text-[#C4B6BE] border border-[#F0E5DC] dark:border-[#3D3145] px-1.5 py-0.2 rounded-full font-medium">Soon</span>
              </div>
              <span class="text-[10px] text-[#78666C] dark:text-[#C4B6BE]">Count heartbeats till airport hugs</span>
            </div>
          </div>
          <div class="flex items-start gap-2.5 px-3 py-2 rounded-xl opacity-60">
            <span class="text-base mt-0.5">☀️</span>
            <div class="flex flex-col">
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-medium text-[#2D2226] dark:text-[#FDFBF7]">Time Overlap Planner</span>
                <span class="text-[9px] bg-[#FAF5EE] dark:bg-[#16131A] text-[#78666C] dark:text-[#C4B6BE] border border-[#F0E5DC] dark:border-[#3D3145] px-1.5 py-0.2 rounded-full font-medium">Soon</span>
              </div>
              <span class="text-[10px] text-[#78666C] dark:text-[#C4B6BE]">Find your sweet golden hour</span>
            </div>
          </div>
          <div class="flex items-start gap-2.5 px-3 py-2 rounded-xl opacity-60">
            <span class="text-base mt-0.5">🍿</span>
            <div class="flex flex-col">
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-medium text-[#2D2226] dark:text-[#FDFBF7]">Movie Night Planner</span>
                <span class="text-[9px] bg-[#FAF5EE] dark:bg-[#16131A] text-[#78666C] dark:text-[#C4B6BE] border border-[#F0E5DC] dark:border-[#3D3145] px-1.5 py-0.2 rounded-full font-medium">Soon</span>
              </div>
              <span class="text-[10px] text-[#78666C] dark:text-[#C4B6BE]">Couch cuddles across oceans</span>
            </div>
          </div>
        </div>
      </div>

      <a href="/guides" class={`transition-all duration-200 ${isActive('/guides')}`}>Guides & Heart</a>
      <a href="/about" class={`transition-all duration-200 ${isActive('/about')}`}>Our Story</a>
    </nav>

    <!-- Desktop Actions: Heartfelt Badge + One-Touch Theme Toggle -->
    <div class="hidden md:flex items-center gap-3 z-50">
      <!-- Lovable Community Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FDE8EF] dark:bg-[#28202E] border border-[#F0E5DC] dark:border-[#3D3145] text-[11px] font-medium text-[#E15B7B] dark:text-[#FBBF24]">
        <span>🕊️</span>
        <span>For two hearts anywhere</span>
      </div>

      <!-- One-Touch Daylight / Warm Lamp Toggle -->
      <button 
        id="theme-toggle-btn" 
        class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white dark:bg-[#261E2C] border border-[#F0E5DC] dark:border-[#3D3145] hover:border-[#E15B7B]/40 dark:hover:border-[#FBBF24]/40 shadow-sm transition-all cursor-pointer focus-ring"
        title="Toggle between Daylight Haven and Warm Lamp Night"
        aria-label="Toggle Warm Theme"
      >
        <span id="theme-sun-icon" class="text-sm select-none">☀️</span>
        <span id="theme-moon-icon" class="text-sm select-none hidden">🏮</span>
        <span id="theme-label" class="text-[11px] font-medium text-[#78666C] dark:text-[#C4B6BE] select-none">Daylight</span>
      </button>
    </div>

    <!-- Mobile Menu Button & Mobile Theme Toggle -->
    <div class="flex md:hidden items-center gap-2 z-50">
      <!-- Mobile quick theme toggle -->
      <button 
        id="mobile-theme-toggle-btn"
        class="w-9 h-9 rounded-full flex items-center justify-center bg-white dark:bg-[#261E2C] border border-[#F0E5DC] dark:border-[#3D3145] text-base shadow-sm focus-ring cursor-pointer"
        aria-label="Toggle Warm Theme"
      >
        <span id="mobile-theme-icon">☀️</span>
      </button>

      <!-- Hamburger Button -->
      <button 
        id="mobile-menu-btn" 
        class="w-9 h-9 rounded-full flex items-center justify-center bg-white dark:bg-[#261E2C] border border-[#F0E5DC] dark:border-[#3D3145] text-[#2D2226] dark:text-[#FDFBF7] focus:outline-none" 
        aria-label="Toggle mobile menu" 
        aria-expanded="false"
      >
        <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5 hidden">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-0 left-0 w-full min-h-screen bg-[#FFFDF9]/98 dark:bg-[#16131A]/98 backdrop-blur-2xl z-40 px-6 pt-24 pb-8 flex flex-col justify-between transition-colors duration-300">
    <div class="flex flex-col gap-6">
      <nav class="flex flex-col gap-2 text-base font-medium">
        <a href="/" class="py-2.5 px-4 rounded-xl hover:bg-[#FDE8EF] dark:hover:bg-white/5 text-[#2D2226] dark:text-[#FDFBF7] transition-colors">Home</a>
        
        <!-- Mobile Dropdown Accordion -->
        <div class="flex flex-col">
          <button id="mobile-tools-trigger" class="py-2.5 px-4 rounded-xl flex items-center justify-between text-left text-[#2D2226] dark:text-[#FDFBF7] hover:bg-[#FDE8EF] dark:hover:bg-white/5 transition-colors">
            <span>Couples Tools</span>
            <svg id="mobile-tools-chevron" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 transition-transform duration-300">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div id="mobile-tools-list" class="hidden flex-col gap-1.5 pl-6 py-2">
            <a href="/tools/gift-date-planner" class="py-2 flex items-center justify-between text-sm font-semibold text-[#E15B7B] dark:text-[#FBBF24]">
              <span class="flex items-center gap-2"><span>🎁</span> Gift & Date Planner</span>
              <span class="text-[9px] bg-[#E15B7B] text-white px-2 py-0.5 rounded-full font-bold">LIVE</span>
            </a>
            <div class="py-2 flex items-center justify-between text-sm text-[#78666C]/60 dark:text-[#C4B6BE]/60">
              <span class="flex items-center gap-2"><span>⏳</span> Reunion Countdown</span>
              <span class="text-[9px] border border-[#F0E5DC] dark:border-[#3D3145] px-1.5 py-0.5 rounded-full">Soon</span>
            </div>
            <div class="py-2 flex items-center justify-between text-sm text-[#78666C]/60 dark:text-[#C4B6BE]/60">
              <span class="flex items-center gap-2"><span>☀️</span> Time Overlap Planner</span>
              <span class="text-[9px] border border-[#F0E5DC] dark:border-[#3D3145] px-1.5 py-0.5 rounded-full">Soon</span>
            </div>
            <div class="py-2 flex items-center justify-between text-sm text-[#78666C]/60 dark:text-[#C4B6BE]/60">
              <span class="flex items-center gap-2"><span>🍿</span> Movie Night Planner</span>
              <span class="text-[9px] border border-[#F0E5DC] dark:border-[#3D3145] px-1.5 py-0.5 rounded-full">Soon</span>
            </div>
          </div>
        </div>

        <a href="/guides" class="py-2.5 px-4 rounded-xl hover:bg-[#FDE8EF] dark:hover:bg-white/5 text-[#2D2226] dark:text-[#FDFBF7] transition-colors">Guides & Heart</a>
        <a href="/about" class="py-2.5 px-4 rounded-xl hover:bg-[#FDE8EF] dark:hover:bg-white/5 text-[#2D2226] dark:text-[#FDFBF7] transition-colors">Our Story</a>
      </nav>
    </div>

    <!-- Mobile Footer Note -->
    <div class="flex flex-col items-center gap-3 text-xs text-[#78666C] dark:text-[#C4B6BE] pt-8 border-t border-[#F0E5DC] dark:border-[#3D3145]">
      <span class="stamp-badge">💕 Made for couples everywhere</span>
      <p class="font-serif text-sm font-semibold text-[#2D2226] dark:text-[#FDFBF7]">Will Meet Soon</p>
    </div>
  </div>
</header>

<script>
  function setupThemeAndNavbar() {
    // Theme toggle management
    const themeToggleBtn = document.getElementById('theme-toggle-btn');
    const mobileThemeToggleBtn = document.getElementById('mobile-theme-toggle-btn');
    const sunIcon = document.getElementById('theme-sun-icon');
    const moonIcon = document.getElementById('theme-moon-icon');
    const themeLabel = document.getElementById('theme-label');
    const mobileThemeIcon = document.getElementById('mobile-theme-icon');

    function updateThemeUI(isDark: boolean) {
      if (sunIcon && moonIcon && themeLabel) {
        if (isDark) {
          sunIcon.classList.add('hidden');
          moonIcon.classList.remove('hidden');
          themeLabel.textContent = 'Warm Lamp';
        } else {
          sunIcon.classList.remove('hidden');
          moonIcon.classList.add('hidden');
          themeLabel.textContent = 'Daylight';
        }
      }
      if (mobileThemeIcon) {
        mobileThemeIcon.textContent = isDark ? '🏮' : '☀️';
      }
    }

    const currentIsDark = document.documentElement.classList.contains('dark');
    updateThemeUI(currentIsDark);

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeUI(isDark);
    }

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', toggleTheme);
    }
    if (mobileThemeToggleBtn) {
      mobileThemeToggleBtn.addEventListener('click', toggleTheme);
    }

    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    const mobileToolsTrigger = document.getElementById('mobile-tools-trigger');
    const mobileToolsList = document.getElementById('mobile-tools-list');
    const mobileToolsChevron = document.getElementById('mobile-tools-chevron');

    if (mobileMenuBtn && mobileMenu && hamburgerIcon && closeIcon) {
      mobileMenuBtn.onclick = () => {
        const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
        mobileMenuBtn.setAttribute('aria-expanded', String(!isExpanded));
        
        mobileMenu.classList.toggle('hidden');
        hamburgerIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden', !isExpanded);
      };
    }

    if (mobileToolsTrigger && mobileToolsList && mobileToolsChevron) {
      mobileToolsTrigger.onclick = () => {
        const isHidden = mobileToolsList.classList.contains('hidden');
        mobileToolsList.classList.toggle('hidden');
        mobileToolsChevron.classList.toggle('rotate-180', isHidden);
      };
    }
  }

  setupThemeAndNavbar();
  document.addEventListener('astro:after-swap', setupThemeAndNavbar);
</script>
