---
// GiftingEngine.astro - Dynamic Gift and Date Night Suggestion Engine for Long Distance Couples
---

<div class="w-full max-w-6xl mx-auto px-4 py-8 relative z-10">
  <!-- Search/Form Container -->
  <div id="generator-card" class="glow-border rounded-xl p-8 md:p-12 mb-8 transition-all duration-500">
    <div class="mb-8">
      <span class="text-[#533afd] text-xs font-semibold uppercase tracking-wider px-3 py-1 bg-[#533afd]/10 rounded-full">
        LDR Recommendation Engine
      </span>
      <h2 class="text-3xl md:text-4xl font-light text-white mt-4 tracking-tight">
        Plan Your Next Connection
      </h2>
      <p class="text-[#64748d] mt-2 font-light">
        Enter your details to generate custom gift ideas, remote date nights, and shipping-optimized paths to bypass customs.
      </p>
    </div>

    <form id="recommendation-form" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Partner A (Your) Country -->
        <div>
          <label for="your-country" class="block text-sm font-medium text-[#61718a] mb-2">Your Country</label>
          <select id="your-country" name="your-country" required class="focus-ring w-full bg-[#0d253d]/50 border border-white/10 rounded-md py-3 px-4 text-white font-light text-sm focus:border-[#533afd] transition-all">
            <option value="US" selected>United States ($)</option>
            <option value="IN">India (₹)</option>
            <option value="GB">United Kingdom (£)</option>
            <option value="CA">Canada (C$)</option>
            <option value="DE">Germany (€)</option>
            <option value="AU">Australia (A$)</option>
            <option value="SG">Singapore (S$)</option>
          </select>
        </div>

        <!-- Partner B (Partner's) Country -->
        <div>
          <label for="partner-country" class="block text-sm font-medium text-[#61718a] mb-2">Partner's Country</label>
          <select id="partner-country" name="partner-country" required class="focus-ring w-full bg-[#0d253d]/50 border border-white/10 rounded-md py-3 px-4 text-white font-light text-sm focus:border-[#533afd] transition-all">
            <option value="IN" selected>India (₹)</option>
            <option value="US">United States ($)</option>
            <option value="GB">United Kingdom (£)</option>
            <option value="CA">Canada (C$)</option>
            <option value="DE">Germany (€)</option>
            <option value="AU">Australia (A$)</option>
            <option value="SG">Singapore (S$)</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Budget -->
        <div>
          <label for="budget" class="block text-sm font-medium text-[#61718a] mb-2">Budget Max</label>
          <select id="budget" name="budget" required class="focus-ring w-full bg-[#0d253d]/50 border border-white/10 rounded-md py-3 px-4 text-white font-light text-sm focus:border-[#533afd] transition-all">
            <!-- Dynamically populated in script based on "Your Country" -->
            <option value="low">Under $25 (Budget-friendly)</option>
            <option value="medium" selected>$25 - $75 (Sweet Spot)</option>
            <option value="high">$75 - $200 (Premium Care)</option>
            <option value="premium">$200+ (Luxury & Milestones)</option>
          </select>
        </div>

        <!-- Occasion -->
        <div>
          <label for="occasion" class="block text-sm font-medium text-[#61718a] mb-2">Occasion</label>
          <select id="occasion" name="occasion" required class="focus-ring w-full bg-[#0d253d]/50 border border-white/10 rounded-md py-3 px-4 text-white font-light text-sm focus:border-[#533afd] transition-all">
            <option value="anniversary" selected>Anniversary</option>
            <option value="birthday">Birthday</option>
            <option value="holiday">Holiday / Christmas</option>
            <option value="just-because">Just Because</option>
            <option value="first-meet">First Face-to-Face Meeting</option>
          </select>
        </div>

        <!-- Relationship Duration -->
        <div>
          <label for="duration" class="block text-sm font-medium text-[#61718a] mb-2">Relationship Duration</label>
          <select id="duration" name="duration" required class="focus-ring w-full bg-[#0d253d]/50 border border-white/10 rounded-md py-3 px-4 text-white font-light text-sm focus:border-[#533afd] transition-all">
            <option value="new">Less than 6 Months (Fresh Spark)</option>
            <option value="mid" selected>6 Months - 2 Years (LD Vets)</option>
            <option value="long">2+ Years (Deeply Committed)</option>
          </select>
        </div>
      </div>

      <div class="pt-4 flex justify-end">
        <button type="submit" class="focus-ring w-full md:w-auto bg-[#533afd] text-white hover:bg-[#4434d4] transition-colors py-3 px-8 rounded-full font-medium text-sm flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-[#533afd]/20">
          <span>Find Gift & Date Ideas</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </button>
      </div>
    </form>
  </div>

  <!-- SECTION 4: Live Countdown & Milestone Planner (Placed below the planner form, visible always) -->
  <div id="countdown-card" class="glow-border rounded-xl p-8 md:p-12 relative overflow-hidden mb-12">
    <!-- Background elements -->
    <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-gradient-to-tr from-[#533afd]/10 to-[#ea2261]/5 blur-3xl pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-center relative z-10">
      <div class="lg:col-span-2">
        <span class="text-[#533afd] text-xs font-semibold uppercase tracking-wider">
          Reunion Countdown
        </span>
        <h4 class="text-2xl md:text-3xl font-light text-white mt-2 tracking-tight">
          Counting Down the Days
        </h4>
        <p class="text-[#64748d] mt-3 text-sm font-light leading-relaxed">
          Long distance is hard, but it's always temporary. Set the date for your next physical reunion flight or meetup and keep the spark burning together.
        </p>
        <div class="mt-6 flex gap-3">
          <input type="date" id="reunion-date-input" name="reunion-date" aria-label="Reunion Date" class="focus-ring bg-[#0b0c16] border border-white/10 text-white text-xs rounded-md py-2 px-3 focus:border-[#533afd]" />
          <button id="set-reunion-btn" class="bg-white text-black hover:bg-neutral-200 transition-colors text-xs font-semibold py-2 px-4 rounded-md cursor-pointer" aria-label="Set Reunion Countdown Date">
            Set Date
          </button>
        </div>
      </div>

      <div class="lg:col-span-3 flex justify-center lg:justify-end">
        <div class="grid grid-cols-4 gap-4 md:gap-6 text-center">
          <div class="bg-[#0d253d]/40 border border-white/5 rounded-xl p-4 md:p-6 min-w-[70px] md:min-w-[100px]">
            <span id="countdown-days" class="block text-3xl md:text-4xl lg:text-5xl font-extralight text-white tabular-nums">00</span>
            <span class="text-[10px] md:text-xs text-[#61718a] uppercase tracking-wider mt-2 block">Days</span>
          </div>

          <div class="bg-[#0d253d]/40 border border-white/5 rounded-xl p-4 md:p-6 min-w-[70px] md:min-w-[100px]">
            <span id="countdown-hours" class="block text-3xl md:text-4xl lg:text-5xl font-extralight text-white tabular-nums">00</span>
            <span class="text-[10px] md:text-xs text-[#61718a] uppercase tracking-wider mt-2 block">Hours</span>
          </div>

          <div class="bg-[#0d253d]/40 border border-white/5 rounded-xl p-4 md:p-6 min-w-[70px] md:min-w-[100px]">
            <span id="countdown-minutes" class="block text-3xl md:text-4xl lg:text-5xl font-extralight text-white tabular-nums">00</span>
            <span class="text-[10px] md:text-xs text-[#61718a] uppercase tracking-wider mt-2 block">Mins</span>
          </div>

          <div class="bg-[#0d253d]/40 border border-white/5 rounded-xl p-4 md:p-6 min-w-[70px] md:min-w-[100px]">
            <span id="countdown-seconds" class="block text-3xl md:text-4xl lg:text-5xl font-extralight text-[#ea2261] tabular-nums">00</span>
            <span class="text-[10px] md:text-xs text-[#61718a] uppercase tracking-wider mt-2 block">Secs</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading State (hidden initially) -->
  <div id="loader" class="hidden flex-col items-center justify-center py-20" role="status" aria-live="polite">
    <div class="w-12 h-12 border-4 border-[#533afd]/20 border-t-[#533afd] rounded-full animate-spin"></div>
    <p class="text-[#64748d] mt-6 font-light animate-pulse">Calculating timezone overlaps and logistics…</p>
  </div>

  <!-- Output Results Panel (hidden initially) -->
  <div id="results-panel" class="hidden space-y-12 transition-all duration-700 opacity-0 transform translate-y-10">
    
    <!-- SECTION 1: Logistics & Timezone Matcher -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Logistics Alert Card -->
      <div class="glow-border rounded-xl p-6 lg:col-span-2 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-yellow-500/10 text-yellow-500">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
              </svg>
            </div>
            <h3 class="text-xl font-light text-white">Dual-Country Shipping Advisor</h3>
          </div>
          <p id="logistics-warning-text" class="text-[#64748d] text-sm font-light leading-relaxed">
            Shipping physical items between selected countries can lead to high customs duties and delays.
          </p>
        </div>
        <div class="mt-6 p-4 rounded-lg bg-[#0d253d]/50 border border-white/5 text-xs text-[#b9b9f9] flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 flex-shrink-0 mt-0.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 111.063.852l-.708 2.836a.75.75 0 001.063.852l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
          </svg>
          <div>
            <strong class="font-medium text-white block mb-1">Our Strategy:</strong>
            We recommend ordering from local e-commerce sites in your partner's country (e.g. Amazon UK, Amazon India) to bypass cross-border courier duties completely, or choosing digital gifts.
          </div>
        </div>
      </div>

      <!-- Timezone Overlap Card (Best Call Today) -->
      <div class="glow-border rounded-xl p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-green-500/10 text-green-500">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-light text-white">Best Call Today</h3>
          </div>
          
          <div class="space-y-4">
            <div class="space-y-3">
              <div class="flex justify-between items-center text-xs">
                <span id="your-tz-label" class="text-[#61718a] font-light">Your Country Time:</span>
                <span id="your-tz-time" class="font-medium text-white tabular-nums">-</span>
              </div>
              <div class="flex justify-between items-center text-xs">
                <span id="partner-tz-label" class="text-[#61718a] font-light">Partner Time:</span>
                <span id="partner-tz-time" class="font-medium text-white tabular-nums">-</span>
              </div>
            </div>

            <div class="border-t border-white/5 pt-3">
              <div class="text-[10px] uppercase tracking-wider text-[#61718a] mb-1 font-semibold">Perfect For</div>
              <div id="overlap-perfect-note" class="text-sm font-light text-green-400 leading-relaxed">-</div>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-2 border-t border-white/5 flex items-center justify-between text-[10px] text-[#61718a] font-light">
          <span>Tabular precision</span>
          <span>Dual timezone sync</span>
        </div>
      </div>
    </div>

    <!-- SECTION 2: Curated Gift Ideas -->
    <div>
      <div class="mb-6 flex justify-between items-end">
        <div>
          <h3 class="text-2xl font-light text-white">Custom Gifting Guide</h3>
          <p class="text-sm text-[#64748d] mt-1 font-light">Custom recommendations tailored to your exact budget & shipping boundaries.</p>
        </div>
        <div class="text-xs text-[#61718a]">
          <span class="inline-block w-2.5 h-2.5 bg-[#533afd] rounded-full mr-1.5 align-middle"></span>
          Delivery Optimized
        </div>
      </div>

      <!-- Gifts Grid -->
      <div id="gifts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Dynamically Rendered Cards go here -->
      </div>
    </div>

    <!-- SECTION 3: Date Night Planners -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Virtual Date Card -->
      <div class="glow-border rounded-xl p-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#533afd]/10 to-transparent rounded-bl-full pointer-events-none"></div>
        
        <span class="text-xs font-semibold text-[#b9b9f9] bg-[#533afd]/15 px-3 py-1 rounded-full uppercase tracking-wider">
          Virtual / Apart
        </span>
        
        <h4 class="text-2xl font-light text-white mt-6" id="virtual-date-title">-</h4>
        <p class="text-[#64748d] text-sm mt-3 font-light leading-relaxed" id="virtual-date-desc">-</p>
        
        <div class="mt-8 border-t border-white/5 pt-6">
          <h5 class="text-xs font-semibold text-white uppercase tracking-wider mb-3">How to set it up:</h5>
          <ol class="text-xs text-[#61718a] space-y-2 list-decimal list-inside" id="virtual-date-steps">
            <!-- Steps dynamic -->
          </ol>
        </div>
      </div>

      <!-- Physical Meetup Date Card -->
      <div class="glow-border rounded-xl p-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#ea2261]/10 to-transparent rounded-bl-full pointer-events-none"></div>
        
        <span class="text-xs font-semibold text-pink-300 bg-[#ea2261]/15 px-3 py-1 rounded-full uppercase tracking-wider">
          Reunion / In-Person
        </span>
        
        <h4 class="text-2xl font-light text-white mt-6" id="in-person-date-title">-</h4>
        <p class="text-[#64748d] text-sm mt-3 font-light leading-relaxed" id="in-person-date-desc">-</p>
        
        <div class="mt-8 border-t border-white/5 pt-6">
          <h5 class="text-xs font-semibold text-white uppercase tracking-wider mb-3">Making it special:</h5>
          <ul class="text-xs text-[#61718a] space-y-2 list-disc list-inside" id="in-person-date-steps">
            <!-- Steps dynamic -->
          </ul>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  // Country database mapping with Timezones, Currencies, and Amazon Link templates
  const countries = {
    US: { name: "United States", tzOffset: -5, tzName: "EST", currency: "$", amazon: "https://www.amazon.com/s?k=" },
    IN: { name: "India", tzOffset: 5.5, tzName: "IST", currency: "₹", amazon: "https://www.amazon.in/s?k=" },
    GB: { name: "United Kingdom", tzOffset: 0, tzName: "GMT", currency: "£", amazon: "https://www.amazon.co.uk/s?k=" },
    CA: { name: "Canada", tzOffset: -5, tzName: "EST", currency: "C$", amazon: "https://www.amazon.ca/s?k=" },
    DE: { name: "Germany", tzOffset: 1, tzName: "CET", currency: "€", amazon: "https://www.amazon.de/s?k=" },
    AU: { name: "Australia", tzOffset: 10, tzName: "AEST", currency: "A$", amazon: "https://www.amazon.com.au/s?k=" },
    SG: { name: "Singapore", tzOffset: 8, tzName: "SGT", currency: "S$", amazon: "https://www.amazon.sg/s?k=" },
  };

  // Timezone best call schedules mapping
  const tzOverlapMap = {
    "IN-US": { timeA: "7:30 PM - 10:30 PM", timeB: "10:00 AM - 1:00 PM", note: "Post-dinner wind-down & Morning coffee check-in" },
    "US-IN": { timeA: "10:00 AM - 1:00 PM", timeB: "7:30 PM - 10:30 PM", note: "Morning coffee & Post-dinner catch-up" },
    
    "IN-GB": { timeA: "6:00 PM - 9:00 PM", timeB: "12:30 PM - 3:30 PM", note: "Evening wind-down & Late lunch break chat" },
    "GB-IN": { timeA: "12:30 PM - 3:30 PM", timeB: "6:00 PM - 9:00 PM", note: "Late lunch break & Evening wind-down" },

    "US-GB": { timeA: "9:00 AM - 12:00 PM", timeB: "2:00 PM - 5:00 PM", note: "Morning check-in & Afternoon chat" },
    "GB-US": { timeA: "2:00 PM - 5:00 PM", timeB: "9:00 AM - 12:00 PM", note: "Afternoon chat & Morning check-in" },

    "US-DE": { timeA: "9:00 AM - 12:00 PM", timeB: "3:00 PM - 6:00 PM", note: "Morning catch-up & Late afternoon break" },
    "DE-US": { timeA: "3:00 PM - 6:00 PM", timeB: "9:00 AM - 12:00 PM", note: "Late afternoon break & Morning catch-up" },

    "US-CA": { timeA: "9:00 AM - 5:00 PM", timeB: "9:00 AM - 5:00 PM", note: "Fully aligned daytime working and awake hours" },
    "CA-US": { timeA: "9:00 AM - 5:00 PM", timeB: "9:00 AM - 5:00 PM", note: "Fully aligned daytime working and awake hours" },

    "US-AU": { timeA: "7:00 PM - 10:00 PM", timeB: "10:00 AM - 1:00 PM", note: "Evening wind-down & Morning coffee next day" },
    "AU-US": { timeA: "10:00 AM - 1:00 PM", timeB: "7:00 PM - 10:00 PM", note: "Morning coffee & Evening wind-down previous day" },

    "US-SG": { timeA: "8:00 PM - 10:00 PM", timeB: "9:00 AM - 11:00 AM", note: "Night chat & Morning check-in next day" },
    "SG-US": { timeA: "9:00 AM - 11:00 AM", timeB: "8:00 PM - 10:00 PM", note: "Morning check-in & Night chat previous day" },

    "IN-CA": { timeA: "7:30 PM - 10:30 PM", timeB: "10:00 AM - 1:00 PM", note: "Post-dinner catch up & Morning check-in" },
    "CA-IN": { timeA: "10:00 AM - 1:00 PM", timeB: "7:30 PM - 10:30 PM", note: "Morning check-in & Post-dinner catch up" },

    "IN-DE": { timeA: "5:30 PM - 8:30 PM", timeB: "2:00 PM - 5:00 PM", note: "Late afternoon tea & Lunch break" },
    "DE-IN": { timeA: "2:00 PM - 5:00 PM", timeB: "5:30 PM - 8:30 PM", note: "Lunch break & Late afternoon tea" },

    "IN-AU": { timeA: "2:00 PM - 5:00 PM", timeB: "6:30 PM - 9:30 PM", note: "Afternoon check-in & Evening wind-down" },
    "AU-IN": { timeA: "6:30 PM - 9:30 PM", timeB: "2:00 PM - 5:00 PM", note: "Evening wind-down & Afternoon check-in" },

    "IN-SG": { timeA: "10:00 AM - 6:00 PM", timeB: "12:30 PM - 8:30 PM", note: "Mid-day chat & Afternoon tea" },
    "SG-IN": { timeA: "12:30 PM - 8:30 PM", timeB: "10:00 AM - 6:00 PM", note: "Afternoon tea & Mid-day chat" },

    "GB-DE": { timeA: "9:00 AM - 5:00 PM", timeB: "10:00 AM - 6:00 PM", note: "Fully aligned daytime and working hours" },
    "DE-GB": { timeA: "10:00 AM - 6:00 PM", timeB: "9:00 AM - 5:00 PM", note: "Fully aligned daytime and working hours" },

    "GB-AU": { timeA: "8:00 AM - 11:00 AM", timeB: "6:00 PM - 9:00 PM", note: "Morning coffee & Evening catch-up" },
    "AU-GB": { timeA: "6:00 PM - 9:00 PM", timeB: "8:00 AM - 11:00 AM", note: "Evening catch-up & Morning coffee" },

    "GB-SG": { timeA: "9:00 AM - 12:00 PM", timeB: "5:00 PM - 8:00 PM", note: "Morning check-in & Evening wind-down" },
    "SG-GB": { timeA: "5:00 PM - 8:00 PM", timeB: "9:00 AM - 12:00 PM", note: "Evening wind-down & Morning check-in" },

    "CA-DE": { timeA: "9:00 AM - 12:00 PM", timeB: "3:00 PM - 6:00 PM", note: "Morning coffee & Late afternoon break" },
    "DE-CA": { timeA: "3:00 PM - 6:00 PM", timeB: "9:00 AM - 12:00 PM", note: "Late afternoon break & Morning coffee" },

    "CA-AU": { timeA: "7:00 PM - 10:00 PM", timeB: "10:00 AM - 1:00 PM", note: "Evening wind-down & Morning coffee next day" },
    "AU-CA": { timeA: "10:00 AM - 1:00 PM", timeB: "7:00 PM - 10:00 PM", note: "Morning coffee & Evening wind-down previous day" },

    "CA-SG": { timeA: "8:00 PM - 10:00 PM", timeB: "9:00 AM - 11:00 AM", note: "Night chat & Morning check-in next day" },
    "SG-CA": { timeA: "9:00 AM - 11:00 AM", timeB: "8:00 PM - 10:00 PM", note: "Morning check-in & Night chat previous day" },

    "DE-AU": { timeA: "8:00 AM - 11:00 AM", timeB: "4:00 PM - 7:00 PM", note: "Morning catch-up & Late afternoon tea" },
    "AU-DE": { timeA: "4:00 PM - 7:00 PM", timeB: "8:00 AM - 11:00 AM", note: "Late afternoon tea & Morning catch-up" },

    "DE-SG": { timeA: "9:00 AM - 12:00 PM", timeB: "4:00 PM - 7:00 PM", note: "Morning check-in & Late afternoon tea" },
    "SG-DE": { timeA: "4:00 PM - 7:00 PM", timeB: "9:00 AM - 12:00 PM", note: "Late afternoon tea & Morning check-in" },

    "AU-SG": { timeA: "11:00 AM - 7:00 PM", timeB: "9:00 AM - 5:00 PM", note: "Mid-day chat & Work hours alignment" },
    "SG-AU": { timeA: "9:00 AM - 5:00 PM", timeB: "11:00 AM - 7:00 PM", note: "Work hours alignment & Mid-day chat" }
  };

  // Dynamic budget list options based on selected "Your Country" currency
  const budgetTiers = {
    US: [
      { value: "low", text: "Under $25 (Budget-friendly)" },
      { value: "medium", text: "$25 - $75 (Sweet Spot)", selected: true },
      { value: "high", text: "$75 - $200 (Premium Care)" },
      { value: "premium", text: "$200+ (Luxury & Milestones)" }
    ],
    IN: [
