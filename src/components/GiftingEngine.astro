// Calculate Confidence Score
let score = 70;
let matchReasons = [];
const tzDiff = Math.abs(yourCountryObj.tzOffset - partnerCountryObj.tzOffset);
if (tzDiff <= 4) {
  score += 10;
  matchReasons.push("perfect time overlap");
} else {
  matchReasons.push("adjusted call coordination");
}
if (yourCountryCode === partnerCountryCode) {
  score += 10;
  matchReasons.push("domestic delivery (no customs)");
} else {
  matchReasons.push("digital customs bypass");
}
score += 10;
matchReasons.push("strict budget fit");
matchReasons.push("partner interest alignment");
score = Math.min(99, score);

// Logistics advice
let logisticsText = "";
if (yourCountryCode === partnerCountryCode) {
  logisticsText = `Since you both live in the <strong>${yourCountryObj.name}</strong>, physical shipping is straightforward! Traditional courier delivery will face no custom duties, and shipping times are minimal. You can also order from local shops directly.`;
} else {
  logisticsText = `Warning: Sending packages between <strong>${yourCountryObj.name}</strong> and <strong>${partnerCountryObj.name}</strong> can result in customs duties of up to 40% and take weeks. <strong>Recommendation:</strong> Use regional vendors (e.g. Amazon ${partnerCountryObj.name} if buying for them, or Amazon ${yourCountryObj.name} if buying for you) or purchase digital experiences to avoid customs.`;
}

// Timezone Call schedule
const staticKey = `${yourCountryCode}-${partnerCountryCode}`;
const staticReverseKey = `${partnerCountryCode}-${yourCountryCode}`;
let staticTimeA = "9:00 AM - 10:00 PM";
let staticTimeB = "9:00 AM - 10:00 PM";
let staticOverlapNote = "Fully synchronized local schedules";

if (yourCountryCode === partnerCountryCode) {
  staticTimeA = "9:00 AM - 10:00 PM";
  staticTimeB = "9:00 AM - 10:00 PM";
  staticOverlapNote = "You live in the same country! Pick any local time.";
} else if (tzOverlapMap[staticKey]) {
  staticTimeA = tzOverlapMap[staticKey].timeA;
  staticTimeB = tzOverlapMap[staticKey].timeB;
  staticOverlapNote = tzOverlapMap[staticKey].note;
} else if (tzOverlapMap[staticReverseKey]) {
  staticTimeA = tzOverlapMap[staticReverseKey].timeB;
  staticTimeB = tzOverlapMap[staticReverseKey].timeA;
  staticOverlapNote = tzOverlapMap[staticReverseKey].note;
} else {
  const diff = Math.abs(yourCountryObj.tzOffset - partnerCountryObj.tzOffset);
  staticTimeA = "7:00 PM - 10:00 PM";
  const startHour = (19 - diff + 24) % 24;
  const endHour = (22 - diff + 24) % 24;
  const formatHour = (h) => `${h % 12 || 12}:00 ${h >= 12 ? 'PM' : 'AM'}`;
  staticTimeB = `${formatHour(startHour)} - ${formatHour(endHour)}`;
  staticOverlapNote = `Adjusted call hours with a ${diff}h timezone difference.`;
}

// Time shifting helper (adds minutes to AM/PM time strings)
function addMinutesToTime(timeStr, minsToAdd) {
  if (!timeStr) return "";
  const match = timeStr.match(/(\d+):(\d+)\s*(AM|PM)/i);
  if (!match) return timeStr;
  
  let hour = parseInt(match[1]);
  const min = parseInt(match[2]);
  const ampm = match[3].toUpperCase();
  
  if (ampm === "PM" && hour !== 12) hour += 12;
  if (ampm === "AM" && hour === 12) hour = 0;
  
  let totalMins = hour * 60 + min + minsToAdd;
  totalMins = (totalMins + 24 * 60) % (24 * 60);
  
  const newHour24 = Math.floor(totalMins / 60);
  const newMin = totalMins % 60;
  
  const newAmpm = newHour24 >= 12 ? "PM" : "AM";
  const newHour12 = newHour24 % 12 || 12;
  
  return `${newHour12}:${String(newMin).padStart(2, '0')} ${newAmpm}`;
}

const staticTimeAStart = staticTimeA.split(" - ")[0];
const staticTimeBStart = staticTimeB.split(" - ")[0];

const timelineTimes = [
  { a: staticTimeAStart, b: staticTimeBStart },
  { a: addMinutesToTime(staticTimeAStart, 30), b: addMinutesToTime(staticTimeBStart, 30) },
  { a: addMinutesToTime(staticTimeAStart, 45), b: addMinutesToTime(staticTimeBStart, 45) },
  { a: addMinutesToTime(staticTimeAStart, 90), b: addMinutesToTime(staticTimeBStart, 90) },
