---
// GiftingEngine.astro - Streamlined AI Gift & Date Connection Flowchart for LDR Couples
import { countries } from '../data/countries';
import { occasionMappings } from '../data/occasionMappings';
import { getSmartOfflinePlan } from '../utils/aiService';

interface Props {
  isStaticRoute?: boolean;
  yourCountry?: string;
  partnerCountry?: string;
}

const { isStaticRoute = false, yourCountry = "US", partnerCountry = "IN" } = Astro.props;

const yourCountryCode = yourCountry.toUpperCase();
const partnerCountryCode = partnerCountry.toUpperCase();
const yourCountryObj = countries[yourCountryCode] || countries.US;
const partnerCountryObj = countries[partnerCountryCode] || countries.IN;

const partnerInterest = "art";
const budgetCategory = "medium";
const occasion = "anniversary";
const duration = "mid";

// Static build plan from smart offline generator
const staticPlan = getSmartOfflinePlan(
  yourCountryCode,
  partnerCountryCode,
  budgetCategory,
  occasion,
  partnerInterest,
  duration
);
---

<div class="w-full max-w-4xl mx-auto px-4 py-4 relative z-10">
  <!-- Clean, Decluttered Input Form -->
  <div id="generator-card" class="card-cozy p-6 sm:p-10 mb-12 transition-all duration-500 relative overflow-hidden">
    <!-- Soft Decorative Accent -->
    <div class="absolute right-0 top-0 w-48 h-48 bg-gradient-to-bl from-[#FDE8EF]/60 via-[#FFEDD5]/30 to-transparent dark:from-[#E15B7B]/10 dark:to-transparent rounded-bl-full pointer-events-none"></div>

    <div class="mb-6 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#FDE8EF] dark:bg-[#E15B7B]/15 rounded-full text-xs font-semibold text-[#E15B7B] dark:text-[#F472B6] mb-2.5">
        <span>✨</span>
        <span>AI-Powered Connection Planner</span>
      </div>
      <h2 class="font-serif text-2xl sm:text-3xl text-[#2D2226] dark:text-[#FDFBF7] tracking-tight">
        Plan Your Next Date & Surprise
      </h2>
      <p class="text-[#78666C] dark:text-[#C4B6BE] mt-1.5 text-xs sm:text-sm font-light max-w-xl leading-relaxed">
        Tell us a little about your partner. We'll curate one customs-free surprise and choreograph your day into an easy visual flowchart.
      </p>
    </div>

    <form id="recommendation-form" class="space-y-5 relative z-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Partner A (Your) Country -->
        <div>
          <label for="your-country" class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-1.5">
            Your Location
          </label>
          <select id="your-country" name="your-country" required class="focus-ring w-full bg-white dark:bg-[#1F1924] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl py-2.5 px-3.5 text-[#2D2226] dark:text-[#FDFBF7] font-normal text-xs sm:text-sm shadow-sm transition-all cursor-pointer">
            {Object.entries(countries).map(([code, c]) => (
              <option value={code} selected={code === "US"}>{c.flag} {c.name} ({c.currency})</option>
            ))}
          </select>
        </div>

        <!-- Partner B (Partner's) Country -->
        <div>
          <label for="partner-country" class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-1.5">
            Partner's Location
          </label>
          <select id="partner-country" name="partner-country" required class="focus-ring w-full bg-white dark:bg-[#1F1924] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl py-2.5 px-3.5 text-[#2D2226] dark:text-[#FDFBF7] font-normal text-xs sm:text-sm shadow-sm transition-all cursor-pointer">
            {Object.entries(countries).map(([code, c]) => (
              <option value={code} selected={code === "IN"}>{c.flag} {c.name} ({c.currency})</option>
            ))}
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Budget -->
        <div>
          <label for="budget" class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-1.5">Budget</label>
          <select id="budget" name="budget" required class="focus-ring w-full bg-white dark:bg-[#1F1924] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl py-2.5 px-3.5 text-[#2D2226] dark:text-[#FDFBF7] font-normal text-xs sm:text-sm shadow-sm transition-all cursor-pointer">
            <option value="low">Under $25 (Sweet & Simple)</option>
            <option value="medium" selected>$25 - $75 (Sweet Spot)</option>
            <option value="high">$75 - $150 (Special Gift)</option>
            <option value="premium">$150+ (Milestone)</option>
          </select>
        </div>

        <!-- Category -->
        <div>
          <label for="interest" class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-1.5">Category</label>
          <select id="interest" name="interest" required class="focus-ring w-full bg-white dark:bg-[#1F1924] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl py-2.5 px-3.5 text-[#2D2226] dark:text-[#FDFBF7] font-normal text-xs sm:text-sm shadow-sm transition-all cursor-pointer">
            <option value="art" selected>🎨 Art & Creativity</option>
            <option value="books">📚 Books & Reading</option>
            <option value="coffee">☕ Coffee & Comfort</option>
            <option value="cooking">🍳 Food & Cooking</option>
            <option value="fitness">🏃 Fitness & Wellness</option>
            <option value="gaming">🎮 Gaming Together</option>
            <option value="movies">🎬 Movies & Shows</option>
            <option value="music">🎵 Music & Podcasts</option>
            <option value="travel">✈️ Travel & Adventure</option>
          </select>
        </div>

        <!-- Occasion -->
        <div>
          <label for="occasion" class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-1.5">Occasion</label>
          <select id="occasion" name="occasion" required class="focus-ring w-full bg-white dark:bg-[#1F1924] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl py-2.5 px-3.5 text-[#2D2226] dark:text-[#FDFBF7] font-normal text-xs sm:text-sm shadow-sm transition-all cursor-pointer">
            {Object.entries(occasionMappings).map(([value, label]) => (
              <option value={value} selected={value === "anniversary"}>{label}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Partner's Personality / Inside Joke Notes for Gemini -->
      <div>
        <label for="partner-notes" class="block text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] uppercase tracking-wider mb-1.5">
          What makes them smile? (Personality, quirks, inside jokes)
        </label>
        <textarea 
          id="partner-notes" 
          name="partner-notes" 
          rows="2" 
          placeholder="e.g. She loves chamomile tea, Studio Ghibli films, gets stressed during exams, and misses wearing my oversized hoodies..." 
          class="focus-ring w-full bg-white dark:bg-[#1F1924] border border-[#F0E5DC] dark:border-[#3D3145] rounded-xl py-2.5 px-4 text-[#2D2226] dark:text-[#FDFBF7] font-normal text-xs sm:text-sm shadow-sm transition-all resize-none placeholder:text-[#78666C]/50 dark:placeholder:text-[#C4B6BE]/40"
        ></textarea>
      </div>

      <div class="pt-2 flex justify-end">
        <button type="submit" class="btn-lovable w-full sm:w-auto bg-gradient-to-r from-[#E15B7B] to-[#F472B6] text-white py-3 px-8 text-sm flex items-center justify-center gap-2 cursor-pointer shadow-md">
          <span>Create Our Connection Plan</span>
          <span>🌸</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Loading State -->
  <div id="loader" class="hidden flex-col items-center justify-center py-16" role="status" aria-live="polite">
    <div class="w-10 h-10 rounded-full border-4 border-[#FDE8EF] border-t-[#E15B7B] dark:border-[#3D3145] dark:border-t-[#FBBF24] animate-spin"></div>
    <p id="loader-text" class="text-[#78666C] dark:text-[#C4B6BE] mt-4 font-light animate-pulse text-xs sm:text-sm text-center max-w-sm">
      ✨ Consulting Gemini AI to curate a border-free gift & choreograph your day's flowchart…
    </p>
  </div>

  <!-- Output Results Panel (Clean 2-Part Layout: The Gift + The Flowchart) -->
  <div id="results-panel" class={isStaticRoute ? "space-y-10" : "hidden space-y-10 transition-all duration-700 opacity-0 transform translate-y-10"}>
    
    <!-- Match Header Banner -->
    <div class="card-cozy p-5 sm:p-6 bg-gradient-to-r from-[#FDE8EF]/80 via-white to-[#FFF1E6]/80 dark:from-[#261E2C] dark:via-[#1F1924] dark:to-[#2A1F2D] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-lg">💖</span>
          <h3 class="font-serif text-lg sm:text-xl text-[#2D2226] dark:text-[#FDFBF7]">
            Curated for You Two
          </h3>
          <span id="match-stars" class="text-amber-400 text-sm">⭐⭐⭐⭐⭐</span>
        </div>
        <p class="text-[#78666C] dark:text-[#C4B6BE] text-xs font-light mt-1">
          <span id="match-reasons" class="font-normal text-[#2D2226] dark:text-[#FDFBF7]">{isStaticRoute ? staticPlan.matchReasons.join(" · ") : "-"}</span>
        </p>
      </div>
      <div id="engine-badge" class="stamp-badge text-[11px] text-[#E15B7B] dark:text-[#FBBF24] shrink-0">
        ✨ AI Curated
      </div>
    </div>

    <!-- PART 1: THE HEARTFELT GIFT RECOMMENDATION (Glare-Free Dark Mode, Zero External Links) -->
    <div id="gift-section">
      <div class="mb-4">
        <span class="stamp-badge text-xs text-[#E15B7B] dark:text-[#FBBF24]">Part 1 · The Surprise</span>
        <h3 class="font-serif text-2xl text-[#2D2226] dark:text-[#FDFBF7] mt-1.5">Top Recommended Gift</h3>
      </div>

      <div id="gift-card-container">
        {isStaticRoute && (
          <div class="card-cozy p-6 sm:p-8 relative overflow-hidden bg-gradient-to-br from-white to-[#FDE8EF]/40 dark:from-[#261E2C] dark:to-[#1A141F]">
            <div class="absolute top-0 right-0 bg-[#E15B7B] dark:bg-[#FBBF24] text-white dark:text-[#16131A] text-[10px] font-bold uppercase tracking-wider px-4 py-1.5 rounded-bl-xl shadow-sm">
              {staticPlan.gift.badge}
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 items-center pt-2">
              <div class="md:col-span-1 h-36 bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] rounded-2xl flex items-center justify-center text-4xl shadow-inner">
                <span>{staticPlan.gift.iconEmoji}</span>
              </div>
              
              <div class="md:col-span-3">
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  <h4 class="font-serif text-xl sm:text-2xl text-[#2D2226] dark:text-[#FDFBF7]">
                    {staticPlan.gift.title} <span class="text-[#E15B7B] dark:text-[#FBBF24] font-sans font-semibold text-lg">· {staticPlan.gift.estimatedPrice}</span>
                  </h4>
                </div>
                <p class="text-xs sm:text-sm text-[#78666C] dark:text-[#C4B6BE] font-light leading-relaxed mb-4">
                  {staticPlan.gift.desc}
                </p>

                <!-- Why It's Perfect List -->
                {staticPlan.gift.whyBestReasons && staticPlan.gift.whyBestReasons.length > 0 && (
                  <div class="mb-4 space-y-1.5">
                    {staticPlan.gift.whyBestReasons.map((reason) => (
                      <div class="flex items-center gap-2 text-xs text-[#78666C] dark:text-[#C4B6BE]">
                        <span class="text-[#E15B7B] dark:text-[#FBBF24] text-xs">✔</span>
                        <span>{reason}</span>
                      </div>
                    ))}
                  </div>
                )}

                <!-- Card Message Idea Preview -->
                {staticPlan.gift.loveNoteIdea && (
                  <div class="mb-4 p-3.5 rounded-xl bg-[#FAF5EE]/90 dark:bg-[#16131A] border border-[#F0E5DC] dark:border-[#3D3145]">
                    <div class="flex items-center justify-between gap-2 mb-1">
                      <span class="text-[10px] font-semibold text-[#E15B7B] dark:text-[#FBBF24] uppercase tracking-wider">💌 Card Note Idea</span>
                      <button type="button" class="copy-note-btn text-[10px] text-[#78666C] dark:text-[#C4B6BE] hover:text-[#E15B7B] dark:hover:text-[#FBBF24] cursor-pointer">Copy</button>
                    </div>
                    <p class="font-serif italic text-xs text-[#2D2226] dark:text-[#FDFBF7]">{staticPlan.gift.loveNoteIdea}</p>
                  </div>
                )}

                <div class="border-t border-[#F0E5DC] dark:border-[#3D3145] pt-3 mt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                  <div class="flex items-center gap-2 text-[#78666C] dark:text-[#C4B6BE]">
                    <span class="font-medium text-[#2D2226] dark:text-[#FDFBF7]">Sourcing Advice:</span>
                    <span>{staticPlan.gift.sourcingTip}</span>
                  </div>
                  <span class="stamp-badge text-[10px] text-[#E15B7B] dark:text-[#FBBF24] shrink-0">
                    Zero Customs 🕊️
                  </span>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- Customs & Delivery Advisory Pill -->
      <div id="customs-advisory-container" class="mt-4 p-4 rounded-2xl bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] flex items-start gap-3 text-xs text-[#78666C] dark:text-[#C4B6BE]">
        <span class="text-base mt-0.5">📦</span>
        <div id="customs-advisory-text" class="leading-relaxed">
          {isStaticRoute ? <Fragment set:html={staticPlan.shippingAdvice} /> : "Customs intelligence loaded dynamically..."}
        </div>
      </div>
    </div>

    <!-- PART 2: THE CONNECTION FLOWCHART (Step-by-Step Visual Journey with Call Times) -->
    <div id="flowchart-section">
      <div class="mb-5">
        <span class="stamp-badge text-xs text-[#FB923C] dark:text-[#FBBF24]">Part 2 · The Connection Plan</span>
        <h3 class="font-serif text-2xl text-[#2D2226] dark:text-[#FDFBF7] mt-1.5">Date Flowchart & Call Times</h3>
        <p class="text-xs text-[#78666C] dark:text-[#C4B6BE] font-light mt-1">A synchronized schedule showing exact local times for both of you.</p>
      </div>

      <div id="flowchart-container" class="space-y-4 relative">
        {isStaticRoute && staticPlan.flowchart.map((step, idx) => (
          <div class="card-cozy p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 relative">
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] flex items-center justify-center text-lg shrink-0 shadow-sm">
                <span>{step.iconEmoji}</span>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-[10px] font-semibold text-[#E15B7B] dark:text-[#FBBF24] uppercase tracking-wider">Step {step.stepNumber}</span>
                  <h4 class="font-serif text-base text-[#2D2226] dark:text-[#FDFBF7]">{step.title}</h4>
                </div>
                <p class="text-xs text-[#78666C] dark:text-[#C4B6BE] font-light leading-relaxed mt-1">{step.action}</p>
              </div>
            </div>
            
            <div class="shrink-0 sm:text-right w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-[#F0E5DC] dark:border-[#3D3145]">
              <span class="inline-block px-3 py-1 rounded-full bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] tabular-nums">
                {step.yourTime} ↔ {step.partnerTime}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</div>

<script>
  import { countries } from '../data/countries';
  import { occasionMappings } from '../data/occasionMappings';
  import { generateAIRecommendations } from '../utils/aiService';

  const form = document.getElementById("recommendation-form");
  const loader = document.getElementById("loader");
  const resultsPanel = document.getElementById("results-panel");
  const generatorCard = document.getElementById("generator-card");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Show soothing loader
      if (generatorCard) generatorCard.classList.add("opacity-50", "pointer-events-none");
      if (resultsPanel) resultsPanel.classList.add("hidden", "opacity-0");
      if (loader) loader.classList.remove("hidden");

      try {
        await runPlanner();
      } catch (err) {
        console.error("Plan generation error:", err);
      } finally {
        if (loader) loader.classList.add("hidden");
        if (generatorCard) generatorCard.classList.remove("opacity-50", "pointer-events-none");
        if (resultsPanel) {
          resultsPanel.classList.remove("hidden");
          setTimeout(() => {
            resultsPanel.classList.remove("opacity-0", "translate-y-10");
          }, 50);
        }
      }
    });
  }

  async function runPlanner() {
    const yourCountryCode = (document.getElementById("your-country") as HTMLSelectElement).value;
    const partnerCountryCode = (document.getElementById("partner-country") as HTMLSelectElement).value;
    const budgetCategory = (document.getElementById("budget") as HTMLSelectElement).value;
    const partnerInterest = (document.getElementById("interest") as HTMLSelectElement).value;
    const occasion = (document.getElementById("occasion") as HTMLSelectElement).value;
    const partnerNotesEl = document.getElementById("partner-notes") as HTMLTextAreaElement;
    const partnerNotes = partnerNotesEl ? partnerNotesEl.value.trim() : "";

    const yourCountry = countries[yourCountryCode] || countries.US;
    const partnerCountry = countries[partnerCountryCode] || countries.IN;

    // Call Gemini 3.6 Flash directly with integrated key & fallback
    const result = await generateAIRecommendations(
      yourCountryCode,
      partnerCountryCode,
      budgetCategory,
      occasion,
      partnerInterest,
      "mid",
      partnerNotes
    );

    // 1. Update Match Header
    const matchStars = document.getElementById("match-stars");
    const matchReasons = document.getElementById("match-reasons");
    const engineBadge = document.getElementById("engine-badge");

    if (matchStars) matchStars.textContent = result.matchStars || "⭐⭐⭐⭐⭐";
    if (matchReasons) matchReasons.textContent = result.matchReasons.join(" · ");
    if (engineBadge) engineBadge.textContent = result.isAiGenerated ? "✨ Gemini AI Curated" : "✨ Thoughtfully Curated";

    // 2. Render Part 1: Top Gift (Glare-Free Dark Mode, Zero External Links)
    const giftContainer = document.getElementById("gift-card-container");
    if (giftContainer) {
      const whyReasonsHtml = result.gift.whyBestReasons && result.gift.whyBestReasons.length > 0 
        ? `<div class="mb-4 space-y-1.5">
            ${result.gift.whyBestReasons.map(r => `
              <div class="flex items-center gap-2 text-xs text-[#78666C] dark:text-[#C4B6BE]">
                <span class="text-[#E15B7B] dark:text-[#FBBF24] text-xs">✔</span>
                <span>${r}</span>
              </div>
            `).join("")}
          </div>` 
        : "";

      const loveNoteHtml = result.gift.loveNoteIdea 
        ? `<div class="mb-4 p-3.5 rounded-xl bg-[#FAF5EE]/90 dark:bg-[#16131A] border border-[#F0E5DC] dark:border-[#3D3145]">
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="text-[10px] font-semibold text-[#E15B7B] dark:text-[#FBBF24] uppercase tracking-wider">💌 Card Note Idea</span>
              <button type="button" class="copy-note-btn text-[10px] text-[#78666C] dark:text-[#C4B6BE] hover:text-[#E15B7B] dark:hover:text-[#FBBF24] cursor-pointer" data-note="${encodeURIComponent(result.gift.loveNoteIdea)}">Copy</button>
            </div>
            <p class="font-serif italic text-xs text-[#2D2226] dark:text-[#FDFBF7]">${result.gift.loveNoteIdea}</p>
          </div>` 
        : "";

      giftContainer.innerHTML = `
        <div class="card-cozy p-6 sm:p-8 relative overflow-hidden bg-gradient-to-br from-white to-[#FDE8EF]/40 dark:from-[#261E2C] dark:to-[#1A141F]">
          <div class="absolute top-0 right-0 bg-[#E15B7B] dark:bg-[#FBBF24] text-white dark:text-[#16131A] text-[10px] font-bold uppercase tracking-wider px-4 py-1.5 rounded-bl-xl shadow-sm">
            ${result.gift.badge || "Top Pick 💕"}
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6 items-center pt-2">
            <div class="md:col-span-1 h-36 bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] rounded-2xl flex items-center justify-center text-4xl shadow-inner select-none animate-float">
              <span>${result.gift.iconEmoji || "🎁"}</span>
            </div>
            
            <div class="md:col-span-3">
              <div class="flex flex-wrap items-center gap-2 mb-1.5">
                <h4 class="font-serif text-xl sm:text-2xl text-[#2D2226] dark:text-[#FDFBF7]">
                  ${result.gift.title} <span class="text-[#E15B7B] dark:text-[#FBBF24] font-sans font-semibold text-lg">· ${result.gift.estimatedPrice}</span>
                </h4>
              </div>
              <p class="text-xs sm:text-sm text-[#78666C] dark:text-[#C4B6BE] font-light leading-relaxed mb-4">
                ${result.gift.desc}
              </p>

              ${whyReasonsHtml}
              ${loveNoteHtml}

              <div class="border-t border-[#F0E5DC] dark:border-[#3D3145] pt-3 mt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-2 text-[#78666C] dark:text-[#C4B6BE]">
                  <span class="font-medium text-[#2D2226] dark:text-[#FDFBF7]">Sourcing Advice:</span>
                  <span>${result.gift.sourcingTip || `Order through local city merchant inside ${partnerCountry.name}`}</span>
                </div>
                <span class="stamp-badge text-[10px] text-[#E15B7B] dark:text-[#FBBF24] shrink-0">
                  Zero Customs 🕊️
                </span>
              </div>
            </div>
          </div>
        </div>
      `;

      // Attach copy listeners
      const copyBtns = giftContainer.querySelectorAll(".copy-note-btn");
      copyBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          const note = decodeURIComponent(btn.getAttribute("data-note") || "");
          if (note) {
            navigator.clipboard.writeText(note);
            btn.textContent = "Copied! ✨";
            setTimeout(() => { btn.textContent = "Copy"; }, 2000);
          }
        });
      });
    }

    // Customs Advisory Text
    const customsText = document.getElementById("customs-advisory-text");
    if (customsText) {
      customsText.innerHTML = result.shippingAdvice;
    }

    // 3. Render Part 2: Connection Flowchart with Call Times
    const flowchartContainer = document.getElementById("flowchart-container");
    if (flowchartContainer) {
      flowchartContainer.innerHTML = result.flowchart.map((step, idx) => `
        <div class="card-cozy p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 relative">
          <div class="flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] flex items-center justify-center text-lg shrink-0 shadow-sm">
              <span>${step.iconEmoji || "✨"}</span>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-semibold text-[#E15B7B] dark:text-[#FBBF24] uppercase tracking-wider">Step ${step.stepNumber || idx + 1}</span>
                <h4 class="font-serif text-base text-[#2D2226] dark:text-[#FDFBF7]">${step.title}</h4>
              </div>
              <p class="text-xs text-[#78666C] dark:text-[#C4B6BE] font-light leading-relaxed mt-1">${step.action}</p>
            </div>
          </div>
          
          <div class="shrink-0 sm:text-right w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-[#F0E5DC] dark:border-[#3D3145]">
            <span class="inline-block px-3 py-1 rounded-full bg-[#FAF5EE] dark:bg-[#1A141F] border border-[#F0E5DC] dark:border-[#3D3145] text-xs font-semibold text-[#2D2226] dark:text-[#FDFBF7] tabular-nums">
              ${step.yourTime} ↔ ${step.partnerTime}
            </span>
          </div>
        </div>
      `).join("");
    }
  }

  // Pre-fill countries from URL parameter if on dynamic route
  function checkUrlForCountries() {
    const yourCountrySelect = document.getElementById("your-country") as HTMLSelectElement;
    if (!form || !yourCountrySelect) return;
    const path = window.location.pathname;
    const match = path.match(/\/gifts\/([A-Za-z]{2})-to-([A-Za-z]{2})/i);
    if (match) {
      const yourCode = match[1].toUpperCase();
      const partnerCode = match[2].toUpperCase();
      if (countries[yourCode] && countries[partnerCode]) {
        yourCountrySelect.value = yourCode;
        const partnerSelect = document.getElementById("partner-country") as HTMLSelectElement;
        if (partnerSelect) partnerSelect.value = partnerCode;
      }
    }
  }

  checkUrlForCountries();
</script>
