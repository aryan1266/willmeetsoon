---
// GiftingEngine.astro - Custom Gift, Date Night, and Logistics Engine for LDR Couples
import { countries } from '../data/countries';
import { occasionMappings } from '../data/occasionMappings';
import { getRecommendations } from '../utils/recommendationEngine';

interface Props {
  isStaticRoute?: boolean;
  yourCountry?: string;
  partnerCountry?: string;
}

const { isStaticRoute = false, yourCountry = "US", partnerCountry = "IN" } = Astro.props;

const yourCountryCode = yourCountry.toUpperCase();
const partnerCountryCode = partnerCountry.toUpperCase();
const yourCountryObj = countries[yourCountryCode] || countries.US;
const partnerCountryObj = countries[partnerCountryCode] || countries.IN;

const partnerInterest = "art";
const budgetCategory = "medium";
const occasion = "anniversary";
const duration = "mid";

// Call recommendation engine
const recommendations = getRecommendations(
  yourCountryCode,
  partnerCountryCode,
  budgetCategory,
  occasion,
  partnerInterest,
  duration
);

const score = recommendations.timezoneAdvice.score;
const matchReasons = recommendations.timezoneAdvice.matchReasons;
const logisticsText = recommendations.shippingAdvice.text;
const staticTimeA = recommendations.timezoneAdvice.timeA;
const staticTimeB = recommendations.timezoneAdvice.timeB;
const staticOverlapNote = recommendations.timezoneAdvice.note;
const timelineTimes = recommendations.timezoneAdvice.timelineTimes;

const staticBestGift = recommendations.gifts[0];
const staticAlternatives = recommendations.gifts.slice(1);
const staticDate = {
  virtual: recommendations.activities[0],
  inPerson: recommendations.activities[1]
};
---

<div class="w-full max-w-6xl mx-auto px-4 py-8 relative z-10">
  <!-- Search/Form Container -->
  <div id="generator-card" class="glow-border rounded-xl p-8 md:p-12 mb-8 transition-all duration-500">
      <div class="mb-8">
        <span class="text-[#533afd] text-xs font-semibold uppercase tracking-wider px-3 py-1 bg-[#533afd]/10 rounded-full">
          LDR Recommendation Engine
        </span>
        <h2 class="text-3xl md:text-4xl font-light text-white mt-4 tracking-tight">
          Plan Your Next Connection
        </h2>
        <p class="text-[#64748d] mt-2 font-light">
          Enter your details to generate custom gift ideas, remote date nights, and shipping-optimized paths to bypass customs.
        </p>
      </div>

      <form id="recommendation-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Partner A (Your) Country -->
          <div>
            <label for="your-country" class="block text-sm font-medium text-[#61718a] mb-2">Your Country</label>
            <select id="your-country" name="your-country" required class="focus-ring w-full bg-[#0d253d]/50 border border-white/10 rounded-md py-3 px-4 text-white font-light text-sm focus:border-[#533afd] transition-all">
              {Object.entries(countries).map(([code, c]) => (
                <option value={code} selected={code === "US"}>{c.flag} {c.name} ({c.currency})</option>
              ))}
            </select>
          </div>

          <!-- Partner B (Partner's) Country -->
          <div>
            <label for="partner-country" class="block text-sm font-medium text-[#61718a] mb-2">Partner's Country</label>
            <select id="partner-country" name="partner-country" required class="focus-ring w-full bg-[#0d253d]/50 border border-white/10 rounded-md py-3 px-4 text-white font-light text-sm focus:border-[#533afd] transition-all">
              {Object.entries(countries).map(([code, c]) => (
                <option value={code} selected={code === "IN"}>{c.flag} {c.name} ({c.currency})</option>
              ))}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Budget -->
          <div>
            <label for="budget" class="block text-sm font-medium text-[#61718a] mb-2">Budget Max</label>
            <select id="budget" name="budget" required class="focus-ring w-full bg-[#0d253d]/50 border border-white/10 rounded-md py-3 px-4 text-white font-light text-sm focus:border-[#533afd] transition-all">
              <!-- Dynamically populated in script based on "Your Country" -->
              <option value="low">Under $25 (Budget-friendly)</option>
              <option value="medium" selected>$25 - $75 (Sweet Spot)</option>
              <option value="high">$75 - $200 (Premium Care)</option>
              <option value="premium">$200+ (Luxury & Milestones)</option>
            </select>
          </div>

          <!-- Partner's Interest -->
          <div>
            <label for="interest" class="block text-sm font-medium text-[#61718a] mb-2">Partner's Interest</label>
            <select id="interest" name="interest" required class="focus-ring w-full bg-[#0d253d]/50 border border-white/10 rounded-md py-3 px-4 text-white font-light text-sm focus:border-[#533afd] transition-all">
              <option value="art" selected>🎨 Art & Sketching</option>
              <option value="gaming">🎮 Gaming</option>
              <option value="music">🎵 Music & Podcasts</option>
              <option value="cooking">🍳 Cooking & Food</option>
              <option value="fitness">💪 Fitness & Wellness</option>
              <option value="coffee">☕ Coffee & Tea</option>
              <option value="reading">📚 Reading & E-books</option>
              <option value="travel">✈️ Travel & Outdoors</option>
            </select>
          </div>

          <!-- Occasion -->
          <div>
            <label for="occasion" class="block text-sm font-medium text-[#61718a] mb-2">Occasion</label>
            <select id="occasion" name="occasion" required class="focus-ring w-full bg-[#0d253d]/50 border border-white/10 rounded-md py-3 px-4 text-white font-light text-sm focus:border-[#533afd] transition-all">
              {Object.entries(occasionMappings).map(([value, label]) => (
                <option value={value} selected={value === "anniversary"}>{label}</option>
              ))}
            </select>
          </div>

          <!-- Relationship Duration -->
          <div>
            <label for="duration" class="block text-sm font-medium text-[#61718a] mb-2">Relationship Duration</label>
            <select id="duration" name="duration" required class="focus-ring w-full bg-[#0d253d]/50 border border-white/10 rounded-md py-3 px-4 text-white font-light text-sm focus:border-[#533afd] transition-all">
              <option value="new">Less than 6 Months (Fresh Spark)</option>
              <option value="mid" selected>6 Months - 2 Years (LD Vets)</option>
              <option value="long">2+ Years (Deeply Committed)</option>
            </select>
          </div>
        </div>

        <div class="pt-4 flex justify-end">
          <button type="submit" class="focus-ring w-full md:w-auto bg-[#533afd] text-white hover:bg-[#4434d4] transition-colors py-3 px-8 rounded-full font-medium text-sm flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-[#533afd]/20">
            <span>Find Gift & Date Ideas</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </button>
        </div>
      </form>
    </div>

    <!-- Loading State (hidden initially) -->
    <div id="loader" class="hidden flex-col items-center justify-center py-20" role="status" aria-live="polite">
      <div class="w-12 h-12 border-4 border-[#533afd]/20 border-t-[#533afd] rounded-full animate-spin"></div>
      <p class="text-[#64748d] mt-6 font-light animate-pulse">Calculating timezone overlaps and logistics…</p>
    </div>

  <!-- Output Results Panel -->
  <div id="results-panel" class={isStaticRoute ? "space-y-12" : "hidden space-y-12 transition-all duration-700 opacity-0 transform translate-y-10"}>
    
    <!-- Confidence score banner -->
    <div class="glow-border rounded-xl p-6 bg-gradient-to-r from-[#533afd]/10 to-[#ea2261]/5 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="text-xl font-light text-white flex items-center gap-2">
          <span>Overall Match Confidence:</span>
          <span id="match-pct" class="font-semibold text-green-400 tabular-nums">{isStaticRoute ? `Overall Match ${score}%` : "-"}</span>
          <span id="match-stars" class="text-yellow-400 font-bold tracking-wider text-sm">{isStaticRoute ? "⭐⭐⭐⭐⭐" : "-"}</span>
        </h3>
        <p class="text-[#64748d] text-xs font-light mt-1">
          Based on: <span id="match-reasons" class="text-[#b9b9f9] font-medium">{isStaticRoute ? matchReasons.join(", ") : "-"}</span>
        </p>
      </div>
      <div class="px-4 py-2 bg-white/5 rounded-full border border-white/10 text-xs text-neutral-300">
        AI Generated Recommendation
      </div>
    </div>

    <!-- SECTION 1: Logistics & Timezone Matcher -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Logistics Alert Card -->
      <div class="glow-border rounded-xl p-6 lg:col-span-2 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-yellow-500/10 text-yellow-500">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
              </svg>
            </div>
            <h3 class="text-xl font-light text-white">Dual-Country Shipping Advice</h3>
          </div>
          <p id="logistics-warning-text" class="text-[#64748d] text-sm font-light leading-relaxed">
            {isStaticRoute ? <Fragment set:html={logisticsText} /> : "Shipping physical items between selected countries can lead to high customs duties and delays."}
          </p>
        </div>
        <div class="mt-6 p-4 rounded-lg bg-[#0d253d]/50 border border-white/5 text-xs text-[#b9b9f9] flex items-start gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 flex-shrink-0 mt-0.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 111.063.852l-.708 2.836a.75.75 0 001.063.852l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
          </svg>
          <div>
            <strong class="font-medium text-white block mb-1">Our Strategy:</strong>
            We recommend ordering from local e-commerce sites in your partner's country (e.g. Amazon UK, Amazon India) to bypass cross-border courier duties completely, or choosing digital gifts.
          </div>
        </div>
      </div>

      <!-- Timezone Overlap Card (Best Call Today) -->
      <div class="glow-border rounded-xl p-6 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-green-500/10 text-green-500">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-light text-white">Best Call Today</h3>
          </div>
          
          <div class="space-y-4">
            <div class="space-y-3">
              <div class="flex justify-between items-center text-xs">
                <span id="your-tz-label" class="text-[#61718a] font-light">
                  {isStaticRoute ? `${yourCountryObj.name} (${yourCountryObj.tzName}):` : "Your Country Time:"}
                </span>
                <span id="your-tz-time" class="font-medium text-white tabular-nums">
                  {isStaticRoute ? staticTimeA : "-"}
                </span>
              </div>
              <div class="flex justify-between items-center text-xs">
                <span id="partner-tz-label" class="text-[#61718a] font-light">
                  {isStaticRoute ? `${partnerCountryObj.name} (${partnerCountryObj.tzName}):` : "Partner Time:"}
                </span>
                <span id="partner-tz-time" class="font-medium text-white tabular-nums">
                  {isStaticRoute ? staticTimeB : "-"}
                </span>
              </div>
            </div>

            <div class="border-t border-white/5 pt-3">
              <div class="text-[10px] uppercase tracking-wider text-[#61718a] mb-1 font-semibold font-display">Perfect For</div>
              <div id="overlap-perfect-note" class="text-sm font-light text-green-400 leading-relaxed font-display">
                {isStaticRoute ? `${staticOverlapNote} & Art lovers (Drawing evening together)` : "-"}
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-2 border-t border-white/5 flex items-center justify-between text-[10px] text-[#61718a] font-light">
          <span>Tabular precision</span>
          <span>Dual timezone sync</span>
        </div>
      </div>
    </div>

    <!-- SECTION 2: Custom Gifting Guide -->
    <div>
      <div class="mb-6">
        <h3 id="gifting-title" class="text-2xl font-light text-white font-display">
          Best {occasionMappings[occasion] || "Anniversary"} Gifts
        </h3>
        <p class="text-sm text-[#64748d] mt-1 font-light">The top matching recommendation shown first, followed by custom alternative gifts.</p>
      </div>

      <!-- Gifting Layout: Best Match + Alternatives Grid -->
      <div class="space-y-6">
        <!-- Best Recommendation Box (Large highlight) -->
        <div id="best-match-box">
          {isStaticRoute && (
            <div class="glow-border rounded-xl p-8 bg-[#533afd]/5 border-[#533afd]/30 border relative overflow-hidden transition-all duration-300">
              <div class="absolute top-0 right-0 bg-[#533afd] text-white text-[10px] font-bold uppercase tracking-wider px-4 py-1.5 rounded-bl-lg">
                Best Match Recommendation
              </div>
              <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-center">
                <div class="lg:col-span-2 h-48 bg-[#0d253d]/50 border border-white/5 rounded-lg flex items-center justify-center relative overflow-hidden">
                  <div class="absolute inset-0 bg-gradient-to-tr from-[#533afd]/10 to-[#ea2261]/10 z-0"></div>
                  <div class="relative z-10 flex flex-col items-center">
                    <Fragment set:html={staticBestGift.imgSvg} />
                  </div>
                </div>
                <div class="lg:col-span-3">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <h4 class="text-2xl font-light text-white leading-snug">
                      {staticBestGift.title} {partnerCountryObj.currency}{staticBestGift.priceVal} {staticBestGift.stars} {staticBestGift.badge}
                    </h4>
                  </div>
                  <p class="text-xs text-[#64748d] font-light leading-relaxed mb-4">
                    {staticBestGift.desc}
                  </p>
                  <div class="border-t border-white/5 pt-4 mt-2">
                    <h5 class="text-xs font-semibold text-white uppercase tracking-wider mb-2 font-display">Why it's the best:</h5>
                    <ul class="text-xs text-[#61718a] space-y-1 list-disc list-inside">
                      <li>Perfect fit for partner's interest in <strong class="text-white">art</strong>.</li>
                      <li>Budget optimized at <strong class="text-white">{partnerCountryObj.currency}{staticBestGift.priceVal}</strong>.</li>
                      <li>Bypasses international custom taxes via local delivery in <strong class="text-white">{partnerCountryObj.name}</strong>.</li>
                    </ul>
                    <div class="mt-6 flex justify-between items-center">
                      <span class="text-[10px] text-[#533afd] font-semibold bg-[#533afd]/10 px-2.5 py-1 rounded-full uppercase tracking-wider">
                        {staticBestGift.badge}
                      </span>
                      <div class="flex items-center gap-2">
                        <span class="text-xs text-[#61718a]">Available at:</span>
                        {staticBestGift.stores.map(store => (
                          <span class="text-xs text-white bg-white/5 border border-white/10 px-2.5 py-1 rounded">
                            {store}
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>

        <!-- Alternatives Grid -->
        <div>
          <h4 class="text-xs font-semibold text-[#61718a] uppercase tracking-wider mb-4 font-display">Alternative Suggestions</h4>
          <div id="alternatives-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {isStaticRoute && staticAlternatives.map(gift => (
              <div class="glow-border rounded-xl p-6 flex flex-col justify-between hover:scale-[1.02] transition-all duration-300">
                <div>
                  <div class="h-36 bg-[#0d253d]/30 border border-white/5 rounded-lg flex items-center justify-center relative overflow-hidden mb-4">
                    <div class="absolute inset-0 bg-gradient-to-tr from-white/5 to-[#533afd]/5 z-0"></div>
                    <div class="relative z-10">
                      <Fragment set:html={gift.imgSvg} />
                    </div>
                  </div>
                  <div class="flex justify-between items-start mb-1">
                    <h4 class="text-base font-light text-white leading-tight">
                      {gift.title} {partnerCountryObj.currency}{gift.priceVal} {gift.stars} {gift.badge}
                    </h4>
                  </div>
                  <p class="text-xs text-[#64748d] font-light leading-relaxed mb-4">{gift.desc}</p>
                </div>
                <div class="border-t border-white/5 pt-4 mt-2 flex justify-between items-center">
                  <span class="text-[9px] text-[#b9b9f9] font-medium bg-white/5 px-2 py-0.5 rounded">
                    Alternative Option
                  </span>
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="text-[10px] text-[#61718a]">Stores:</span>
                    {gift.stores.map(store => (
                      <span class="text-[10px] text-white bg-white/5 border border-white/10 px-2 py-0.5 rounded">
                        {store}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- SECTION 3: Date Night Planners -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Virtual Date Card -->
      <div class="glow-border rounded-xl p-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#533afd]/10 to-transparent rounded-bl-full pointer-events-none"></div>
        
        <span class="text-xs font-semibold text-[#b9b9f9] bg-[#533afd]/15 px-3 py-1 rounded-full uppercase tracking-wider">
          Virtual Dates / Apart
        </span>
        
        <h4 class="text-2xl font-light text-white mt-6 font-display" id="virtual-date-title">
          {isStaticRoute ? staticDate.virtual.title : "-"}
        </h4>
        <p class="text-[#64748d] text-sm mt-3 font-light leading-relaxed" id="virtual-date-desc">
          {isStaticRoute ? staticDate.virtual.desc : "-"}
        </p>
        
        <div class="mt-8 border-t border-white/5 pt-6">
          <h5 class="text-xs font-semibold text-white uppercase tracking-wider mb-3">How to set it up:</h5>
          <ol class="text-xs text-[#61718a] space-y-2 list-decimal list-inside" id="virtual-date-steps">
            {isStaticRoute ? staticDate.virtual.steps.map(step => <li>{step}</li>) : null}
          </ol>
        </div>
      </div>

      <!-- Physical Meetup Date Card -->
      <div class="glow-border rounded-xl p-8 relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-[#ea2261]/10 to-transparent rounded-bl-full pointer-events-none"></div>
        
        <span class="text-xs font-semibold text-pink-300 bg-[#ea2261]/15 px-3 py-1 rounded-full uppercase tracking-wider">
          Reunion / In-Person
        </span>
        
        <h4 class="text-2xl font-light text-white mt-6 font-display" id="in-person-date-title">
          {isStaticRoute ? staticDate.inPerson.title : "-"}
        </h4>
        <p class="text-[#64748d] text-sm mt-3 font-light leading-relaxed" id="in-person-date-desc">
          {isStaticRoute ? staticDate.inPerson.desc : "-"}
        </p>
        
        <div class="mt-8 border-t border-white/5 pt-6">
          <h5 class="text-xs font-semibold text-white uppercase tracking-wider mb-3">Making it special:</h5>
          <ul class="text-xs text-[#61718a] space-y-2 list-disc list-inside" id="in-person-date-steps">
            {isStaticRoute ? staticDate.inPerson.steps.map(step => <li>{step}</li>) : null}
          </ul>
        </div>
      </div>
    </div>

    <!-- SECTION 4: Suggested Date Timeline (Hour-by-hour schedule representation with arrows) -->
    <div class="glow-border rounded-xl p-8 relative overflow-hidden">
      <div class="mb-8 text-center">
        <span class="text-[#ea2261] text-xs font-semibold uppercase tracking-wider">
          Suggested Date Timeline
        </span>
        <h4 class="text-2xl font-light text-white mt-2 font-display">Hour-by-Hour Connection Plan</h4>
        <p class="text-[#64748d] text-sm mt-1 font-light">A synchronized schedule showing local times for both of you.</p>
      </div>

      <div class="flex flex-col items-center max-w-xl mx-auto space-y-6">
        
        <!-- Timeline Item 1 -->
        <div class="text-center w-full max-w-md bg-white/5 border border-white/10 rounded-xl p-5 hover:border-[#533afd]/50 transition-colors duration-300">
          <div class="text-xs font-semibold text-[#b9b9f9] tabular-nums" id="timeline-time-1">
            {isStaticRoute ? `${timelineTimes[0].a} (${yourCountryObj.name}) / ${timelineTimes[0].b} (${partnerCountryObj.name})` : "-"}
          </div>
          <h5 class="text-base font-medium text-white mt-2">Buy & Send a digital gift</h5>
          <p class="text-xs text-[#64748d] mt-2 font-light leading-relaxed">Order surprise takeout to their address or send an instant e-gift card (e.g. food delivery or gaming subscription) to kick off the date night.</p>
        </div>

        <div class="text-[#533afd] text-2xl font-bold flex items-center justify-center h-8 animate-pulse">↓</div>

        <!-- Timeline Item 2 -->
        <div class="text-center w-full max-w-md bg-white/5 border border-white/10 rounded-xl p-5 hover:border-white/20 transition-colors duration-300">
          <div class="text-xs font-semibold text-neutral-400 tabular-nums" id="timeline-time-2">
            {isStaticRoute ? `${timelineTimes[1].a} (${yourCountryObj.name}) / ${timelineTimes[1].b} (${partnerCountryObj.name})` : "-"}
          </div>
          <h5 class="text-base font-medium text-white mt-2">Video call</h5>
          <p class="text-xs text-[#64748d] mt-2 font-light leading-relaxed">Hop on FaceTime, Zoom, or Discord. Put on your noise-cancelling headphones and catch up on your week.</p>
        </div>

        <div class="text-neutral-600 text-2xl font-bold flex items-center justify-center h-8">↓</div>

        <!-- Timeline Item 3 -->
        <div class="text-center w-full max-w-md bg-white/5 border border-white/10 rounded-xl p-5 hover:border-white/20 transition-colors duration-300">
          <div class="text-xs font-semibold text-neutral-400 tabular-nums" id="timeline-time-3">
            {isStaticRoute ? `${timelineTimes[2].a} (${yourCountryObj.name}) / ${timelineTimes[2].b} (${partnerCountryObj.name})` : "-"}
          </div>
          <h5 class="text-base font-medium text-white mt-2 font-display" id="timeline-title-3">
            {isStaticRoute ? "Cook together / Shared Activity" : "Cook together"}
          </h5>
          <p class="text-xs text-[#64748d] mt-2 font-light leading-relaxed" id="timeline-desc-3">
            {isStaticRoute ? `Start your shared Art-themed activity or cooking race! Put on video call on camera and connect.` : "Start your kitchen race! Cook the same recipe side-by-side on camera and pour a glass of wine."}
          </p>
        </div>

        <div class="text-neutral-600 text-2xl font-bold flex items-center justify-center h-8">↓</div>

        <!-- Timeline Item 4 -->
        <div class="text-center w-full max-w-md bg-white/5 border border-white/10 rounded-xl p-5 hover:border-white/20 transition-colors duration-300">
          <div class="text-xs font-semibold text-neutral-400 tabular-nums" id="timeline-time-4">
            {isStaticRoute ? `${timelineTimes[3].a} (${yourCountryObj.name}) / ${timelineTimes[3].b} (${partnerCountryObj.name})` : "-"}
          </div>
          <h5 class="text-base font-medium text-white mt-2 font-display" id="timeline-title-4">
            {isStaticRoute ? `Watch a movie / ${staticDate.virtual.title}` : "Watch a movie"}
          </h5>
          <p class="text-xs text-[#64748d] mt-2 font-light leading-relaxed" id="timeline-desc-4">
            {isStaticRoute ? `${staticDate.virtual.desc} Maintain screen sharing and video connection.` : "Start a synchronized Teleparty or screenshare. Watch your chosen movie while keeping video/audio active."}
          </p>
        </div>

        <div class="text-neutral-600 text-2xl font-bold flex items-center justify-center h-8">↓</div>

        <!-- Timeline Item 5 -->
        <div class="text-center w-full max-w-md bg-gradient-to-b from-[#ea2261]/10 to-transparent border border-[#ea2261]/30 rounded-xl p-5 hover:border-[#ea2261]/60 transition-colors duration-300">
          <div class="text-xs font-semibold text-pink-300 tabular-nums" id="timeline-time-5">
            {isStaticRoute ? `${timelineTimes[4].a} (${yourCountryObj.name}) / ${timelineTimes[4].b} (${partnerCountryObj.name})` : "-"}
          </div>
          <h5 class="text-base font-medium text-[#ea2261] mt-2 font-semibold">Open the gift together</h5>
          <p class="text-xs text-[#64748d] mt-2 font-light leading-relaxed">Unwrap the surprise. Discuss your relationship milestones, check your Bond Touch bracelet counts, and plan your next reunion flight.</p>
        </div>

      </div>
    </div>

  </div>

  <!-- MEETING COUNTDOWN: Moved to the very bottom of the page -->
  <div id="countdown-card" class="glow-border rounded-xl p-8 md:p-12 relative overflow-hidden mt-12">
    <!-- Background elements -->
    <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-gradient-to-tr from-[#533afd]/10 to-[#ea2261]/5 blur-3xl pointer-events-none"></div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-center relative z-10">
      <div class="lg:col-span-2">
        <span class="text-[#533afd] text-xs font-semibold uppercase tracking-wider">
          Reunion Countdown
        </span>
        <h4 class="text-2xl md:text-3xl font-light text-white mt-2 tracking-tight font-display">
          Counting Down the Days
        </h4>
        <p class="text-[#64748d] mt-3 text-sm font-light leading-relaxed">
          Long distance is temporary. Set the date for your next physical meetup or reunion flight and watch the seconds tick away.
        </p>
        <div class="mt-6 flex gap-3">
          <input type="date" id="reunion-date-input" name="reunion-date" aria-label="Reunion Date" class="focus-ring bg-[#0b0c16] border border-white/10 text-white text-xs rounded-md py-2 px-3 focus:border-[#533afd]" />
          <button id="set-reunion-btn" class="bg-white text-black hover:bg-neutral-200 transition-colors text-xs font-semibold py-2 px-4 rounded-md cursor-pointer" aria-label="Set Reunion Countdown Date">
            Set Date
          </button>
        </div>
      </div>

      <div class="lg:col-span-3 flex justify-center lg:justify-end">
        <div class="grid grid-cols-4 gap-4 md:gap-6 text-center">
          <div class="bg-[#0d253d]/40 border border-white/5 rounded-xl p-4 md:p-6 min-w-[70px] md:min-w-[100px]">
            <span id="countdown-days" class="block text-3xl md:text-4xl lg:text-5xl font-extralight text-white tabular-nums">00</span>
            <span class="text-[10px] md:text-xs text-[#61718a] uppercase tracking-wider mt-2 block">Days</span>
          </div>

          <div class="bg-[#0d253d]/40 border border-white/5 rounded-xl p-4 md:p-6 min-w-[70px] md:min-w-[100px]">
            <span id="countdown-hours" class="block text-3xl md:text-4xl lg:text-5xl font-extralight text-white tabular-nums">00</span>
            <span class="text-[10px] md:text-xs text-[#61718a] uppercase tracking-wider mt-2 block">Hours</span>
          </div>

          <div class="bg-[#0d253d]/40 border border-white/5 rounded-xl p-4 md:p-6 min-w-[70px] md:min-w-[100px]">
            <span id="countdown-minutes" class="block text-3xl md:text-4xl lg:text-5xl font-extralight text-white tabular-nums">00</span>
            <span class="text-[10px] md:text-xs text-[#61718a] uppercase tracking-wider mt-2 block">Mins</span>
          </div>

          <div class="bg-[#0d253d]/40 border border-white/5 rounded-xl p-4 md:p-6 min-w-[70px] md:min-w-[100px]">
            <span id="countdown-seconds" class="block text-3xl md:text-4xl lg:text-5xl font-extralight text-[#ea2261] tabular-nums">00</span>
            <span class="text-[10px] md:text-xs text-[#61718a] uppercase tracking-wider mt-2 block">Secs</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { countries, budgetTiers } from '../data/countries';
  import { occasionMappings } from '../data/occasionMappings';
  import { getRecommendations } from '../utils/recommendationEngine';

  const budgetSelect = document.getElementById("budget") as HTMLSelectElement;
  const yourCountrySelect = document.getElementById("your-country") as HTMLSelectElement;

  function updateBudgetCurrency() {
    if (!yourCountrySelect || !budgetSelect) return;
    const country = yourCountrySelect.value;
    const tiers = budgetTiers[country] || budgetTiers.US;
    const currentVal = budgetSelect.value;
    
    budgetSelect.innerHTML = "";
    tiers.forEach(tier => {
      const opt = document.createElement("option");
      opt.value = tier.value;
      opt.textContent = tier.text;
      if (tier.value === currentVal || (currentVal === "" && tier.selected)) {
        opt.selected = true;
      }
      budgetSelect.appendChild(opt);
    });
  }

  if (yourCountrySelect) {
    yourCountrySelect.addEventListener("change", updateBudgetCurrency);
    updateBudgetCurrency();
  }

  // Form submission handler
  const form = document.getElementById("recommendation-form");
  const loader = document.getElementById("loader");
  const resultsPanel = document.getElementById("results-panel");
  const generatorCard = document.getElementById("generator-card");
 
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
 
      // Show Loader
      generatorCard.classList.add("opacity-50", "pointer-events-none");
      resultsPanel.classList.add("hidden", "opacity-0");
      loader.classList.remove("hidden");
 
      setTimeout(() => {
        loader.classList.add("hidden");
        generatorCard.classList.remove("opacity-50", "pointer-events-none");
        resultsPanel.classList.remove("hidden");
        setTimeout(() => {
          resultsPanel.classList.remove("opacity-0", "translate-y-10");
        }, 50);
 
        generateResults();
      }, 1200);
    });
  }

  function generateResults() {
    const yourCountryCode = (document.getElementById("your-country") as HTMLSelectElement).value;
    const partnerCountryCode = (document.getElementById("partner-country") as HTMLSelectElement).value;
    const budgetCategory = (document.getElementById("budget") as HTMLSelectElement).value;
    const partnerInterest = (document.getElementById("interest") as HTMLSelectElement).value;
    const occasion = (document.getElementById("occasion") as HTMLSelectElement).value;
    const duration = (document.getElementById("duration") as HTMLSelectElement).value;

    const yourCountry = countries[yourCountryCode];
    const partnerCountry = countries[partnerCountryCode];

    const recs = getRecommendations(yourCountryCode, partnerCountryCode, budgetCategory, occasion, partnerInterest, duration);

    // 0. Update Gifting Section Title
    const occasionLabel = occasionMappings[occasion] || "Anniversary";
    const giftingTitle = document.getElementById("gifting-title");
    if (giftingTitle) {
      giftingTitle.textContent = `Best ${occasionLabel} Gifts`;
    }

    // 1. Confidence Score
    document.getElementById("match-pct").textContent = `Overall Match ${recs.timezoneAdvice.score}%`;
    document.getElementById("match-stars").textContent = recs.timezoneAdvice.scoreStars;
    document.getElementById("match-reasons").textContent = recs.timezoneAdvice.matchReasons.join(", ");

    // 2. Shipping Logistics Warning
    const logisticsWarningText = document.getElementById("logistics-warning-text");
    if (logisticsWarningText) {
      logisticsWarningText.innerHTML = recs.shippingAdvice.text;
    }

    // 3. Timezones & Overlaps
    const yourTzLabel = document.getElementById("your-tz-label");
    const yourTzTime = document.getElementById("your-tz-time");
    const partnerTzLabel = document.getElementById("partner-tz-label");
    const partnerTzTime = document.getElementById("partner-tz-time");
    const overlapPerfectNote = document.getElementById("overlap-perfect-note");

    yourTzLabel.textContent = recs.timezoneAdvice.yourTzLabel;
    partnerTzLabel.textContent = recs.timezoneAdvice.partnerTzLabel;
    yourTzTime.textContent = recs.timezoneAdvice.timeA;
    partnerTzTime.textContent = recs.timezoneAdvice.timeB;
    overlapPerfectNote.textContent = recs.timezoneAdvice.perfectForNote;

    // 4. Render Gifts
    const bestMatchBox = document.getElementById("best-match-box");
    const alternativesGrid = document.getElementById("alternatives-grid");
    
    bestMatchBox.innerHTML = "";
    alternativesGrid.innerHTML = "";

    const bestGift = recs.gifts[0];
    const alternativesToRender = recs.gifts.slice(1);

    // Render Best Match card
    bestMatchBox.innerHTML = `
      <div class="glow-border rounded-xl p-8 bg-[#533afd]/5 border-[#533afd]/30 border relative overflow-hidden transition-all duration-300">
        <div class="absolute top-0 right-0 bg-[#533afd] text-white text-[10px] font-bold uppercase tracking-wider px-4 py-1.5 rounded-bl-lg">
          Best Match Recommendation
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-center">
          <div class="lg:col-span-2 h-48 bg-[#0d253d]/50 border border-white/5 rounded-lg flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-tr from-[#533afd]/10 to-[#ea2261]/10 z-0"></div>
            <div class="relative z-10 flex flex-col items-center">
              ${bestGift.imgSvg}
            </div>
          </div>
          <div class="lg:col-span-3">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <h4 class="text-2xl font-light text-white leading-snug">${bestGift.title} ${bestGift.localPrice} ${bestGift.stars} ${bestGift.badge}</h4>
            </div>
            <p class="text-xs text-[#64748d] font-light leading-relaxed mb-4">
              ${bestGift.desc}
            </p>
            <div class="border-t border-white/5 pt-4 mt-2">
              <h5 class="text-xs font-semibold text-white uppercase tracking-wider mb-2 font-display">Why it's the best:</h5>
              <ul class="text-xs text-[#61718a] space-y-1 list-disc list-inside">
                ${(bestGift.whyBestReasons || []).map(reason => `<li>${reason}</li>`).join("")}
              </ul>
              <div class="mt-6 flex justify-between items-center">
                <span class="text-[10px] text-[#533afd] font-semibold bg-[#533afd]/10 px-2.5 py-1 rounded-full uppercase tracking-wider">
                  ${bestGift.badge}
                </span>
                <div class="flex items-center gap-2">
                  <span class="text-xs text-[#61718a]">Available at:</span>
                  ${(bestGift.stores || []).map(store => `
                    <span class="text-xs text-white bg-white/5 border border-white/10 px-2.5 py-1 rounded">
                      ${store}
                    </span>
                  `).join("")}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    `;

    // Render Alternative Suggestions
    alternativesToRender.forEach(gift => {
      const card = document.createElement("div");
      card.className = "glow-border rounded-xl p-6 flex flex-col justify-between hover:scale-[1.02] transition-all duration-300";
      card.innerHTML = `
        <div>
          <div class="h-36 bg-[#0d253d]/30 border border-white/5 rounded-lg flex items-center justify-center relative overflow-hidden mb-4">
            <div class="absolute inset-0 bg-gradient-to-tr from-white/5 to-[#533afd]/5 z-0"></div>
            <div class="relative z-10">
              ${gift.imgSvg}
            </div>
          </div>
          <div class="flex justify-between items-start mb-1">
            <h4 class="text-base font-light text-white leading-tight">${gift.title} ${gift.localPrice} ${gift.stars} ${gift.badge}</h4>
          </div>
          <p class="text-xs text-[#64748d] font-light leading-relaxed mb-4">${gift.desc}</p>
        </div>
        <div class="border-t border-white/5 pt-4 mt-2 flex justify-between items-center">
          <span class="text-[9px] text-[#b9b9f9] font-medium bg-white/5 px-2 py-0.5 rounded">
            Alternative Option
          </span>
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="text-[10px] text-[#61718a]">Stores:</span>
            ${(gift.stores || []).map(store => `
              <span class="text-[10px] text-white bg-white/5 border border-white/10 px-2 py-0.5 rounded">
                ${store}
              </span>
            `).join("")}
          </div>
        </div>
      `;
      alternativesGrid.appendChild(card);
    });

    // 5. Set Date activities
    const virtualActivity = recs.activities.find(act => act.type === 'virtual') || recs.activities[0];
    const inPersonActivity = recs.activities.find(act => act.type === 'inPerson') || recs.activities[1];

    document.getElementById("virtual-date-title").textContent = virtualActivity.title;
    document.getElementById("virtual-date-desc").textContent = virtualActivity.desc;
    const virtualSteps = document.getElementById("virtual-date-steps");
    virtualSteps.innerHTML = "";
    virtualActivity.steps.forEach(step => {
      const li = document.createElement("li");
      li.textContent = step;
      virtualSteps.appendChild(li);
    });

    document.getElementById("in-person-date-title").textContent = inPersonActivity.title;
    document.getElementById("in-person-date-desc").textContent = inPersonActivity.desc;
    const inPersonSteps = document.getElementById("in-person-date-steps");
    inPersonSteps.innerHTML = "";
    inPersonActivity.steps.forEach(step => {
      const li = document.createElement("li");
      li.textContent = step;
      inPersonSteps.appendChild(li);
    });

    // 6. Set dynamic timeline times
    const times = recs.timezoneAdvice.timelineTimes;
    document.getElementById("timeline-time-1").textContent = `${times[0].a} (${yourCountry.name}) / ${times[0].b} (${partnerCountry.name})`;
    document.getElementById("timeline-time-2").textContent = `${times[1].a} (${yourCountry.name}) / ${times[1].b} (${partnerCountry.name})`;
    document.getElementById("timeline-time-3").textContent = `${times[2].a} (${yourCountry.name}) / ${times[2].b} (${partnerCountry.name})`;
    document.getElementById("timeline-time-4").textContent = `${times[3].a} (${yourCountry.name}) / ${times[3].b} (${partnerCountry.name})`;
    document.getElementById("timeline-time-5").textContent = `${times[4].a} (${yourCountry.name}) / ${times[4].b} (${partnerCountry.name})`;

    const interestLabel = partnerInterest.charAt(0).toUpperCase() + partnerInterest.slice(1);
    document.getElementById("timeline-title-3").textContent = `Cook together / Shared Activity`;
    document.getElementById("timeline-desc-3").textContent = `Start your shared ${interestLabel}-themed activity or cooking race! Put on video call on camera and connect.`;
    
    document.getElementById("timeline-title-4").textContent = `Watch a movie / ${virtualActivity.title}`;
    document.getElementById("timeline-desc-4").textContent = `${virtualActivity.desc} Maintain screen sharing and video connection.`;
  }

  // 6. Countdown timer script
  let countdownInterval;

  function initCountdown() {
    const defaultDate = new Date();
    defaultDate.setDate(defaultDate.getDate() + 30);
    const defaultDateStr = defaultDate.toISOString().split('T')[0];
    
    const input = document.getElementById("reunion-date-input") as HTMLInputElement;
    if (!input) return;
    input.value = defaultDateStr;

    startTimer(defaultDate.getTime());

    const btn = document.getElementById("set-reunion-btn");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const selectedDate = new Date(input.value);
      if (!isNaN(selectedDate.getTime())) {
        clearInterval(countdownInterval);
        startTimer(selectedDate.getTime());
      }
    });
  }

  function startTimer(targetTimestamp) {
    const daysEl = document.getElementById("countdown-days");
    const hoursEl = document.getElementById("countdown-hours");
    const minsEl = document.getElementById("countdown-minutes");
    const secsEl = document.getElementById("countdown-seconds");

    function update() {
      const now = new Date().getTime();
      const diff = targetTimestamp - now;

      if (diff <= 0) {
        daysEl.textContent = "00";
        hoursEl.textContent = "00";
        minsEl.textContent = "00";
        secsEl.textContent = "00";
        clearInterval(countdownInterval);
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);

      daysEl.textContent = String(days).padStart(2, '0');
      hoursEl.textContent = String(hours).padStart(2, '0');
      minsEl.textContent = String(mins).padStart(2, '0');
      secsEl.textContent = String(secs).padStart(2, '0');
    }

    update();
    countdownInterval = setInterval(update, 1000);
  }

  // Pre-fill countries from URL parameter
  function checkUrlForCountries() {
    if (!form || !yourCountrySelect) return;
    const path = window.location.pathname; // e.g. /gifts/us-to-in
    const match = path.match(/\/gifts\/([A-Za-z]{2})-to-([A-Za-z]{2})/i);
    if (match) {
      const yourCode = match[1].toUpperCase();
      const partnerCode = match[2].toUpperCase();
      
      if (countries[yourCode] && countries[partnerCode]) {
        yourCountrySelect.value = yourCode;
        updateBudgetCurrency();
        
        const partnerSelect = document.getElementById("partner-country") as HTMLSelectElement;
        if (partnerSelect) partnerSelect.value = partnerCode;
      }
    }
  }

  initCountdown();
  checkUrlForCountries();
</script>
